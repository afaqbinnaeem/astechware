<% content_for :head do %>
  <% set_meta_tags(
    title: "Page not found",
    description: "This page is not on astechware.com. Go back to the homepage, services, or case studies.",
    noindex: true,
    nofollow: true
  ) %>
<% end %>

<div class="inner-sections py-5">
  <div class="container py-5">
    <div class="col-12 col-lg-8 mx-auto text-center">
      <h1 class="display-5 fw-bold mb-3" data-page-h1>Page not found</h1>
      <p class="lead mb-4">That page is not here. Try one of these instead.</p>
      <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
        <%= link_to "Home", root_path, class: "btn btn-primary rounded-pill px-4" %>
        <%= link_to "Services", services_path, class: "btn btn-outline-primary rounded-pill px-4" %>
        <%= link_to "Case studies", case_studies_path, class: "btn btn-outline-primary rounded-pill px-4" %>
      </div>
    </div>
  </div>
</div>
