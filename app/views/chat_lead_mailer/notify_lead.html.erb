<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <h2>New Lead from Chat Widget</h2>
    
    <h3>Contact Information</h3>
    <p><strong>Name:</strong> <%= @name.presence || 'Not provided' %></p>
    <p><strong>Email:</strong> <%= @email.presence || 'Not provided' %></p>
    <% if @company_name.present? %>
      <p><strong>Company Name:</strong> <%= @company_name %></p>
    <% end %>
    
    <h3>Description / Query</h3>
    <p><%= @description.presence || 'No description provided' %></p>
    
    <% if @conversation_summary.present? %>
      <h3>Conversation Summary</h3>
      <p><%= @conversation_summary %></p>
    <% end %>
    
    <hr>
    <p><small>Received at: <%= @timestamp.strftime('%B %d, %Y at %I:%M %p') %></small></p>
    <p><small>Source: Chat Widget</small></p>
  </body>
</html>
