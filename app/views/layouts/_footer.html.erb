<footer class="site-footer" id="footer" role="contentinfo">
  <div class="footer-main">
    <div class="container">
      <div class="row g-4 g-lg-5 py-5">
        <%# Column 1: Company Info %>
        <div class="col-12 col-lg-4 col-xl-3 footer-col footer-company">
          <div class="footer-logo mb-3">
            <%= link_to root_path, class: "d-inline-block" do %>
              <%= image_tag 'logo.png', width: '120', class: 'img-fluid', alt: "A'sTechware Logo, AI & Platform Engineering", loading: "lazy" %>
            <% end %>
          </div>
          <p class="footer-mission text-muted small mb-4">
            We build software and automation that take the busywork off legal, healthcare, construction and logistics teams, so they can grow without adding headcount.
          </p>
          <div class="footer-social mb-3">
            <ul class="list-unstyled d-flex flex-wrap gap-2 m-0 align-items-center">
              <li><a href="https://www.linkedin.com/company/astechware" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="LinkedIn"><i class="fa fa-linkedin" aria-hidden="true"></i></a></li>
              <li><a href="https://www.youtube.com/@ahmadkamran518" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="YouTube"><i class="fa fa-youtube" aria-hidden="true"></i></a></li>
              <li><a href="https://clutch.co/profile/astechware" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Clutch"><span class="footer-social-monogram" aria-hidden="true">C</span></a></li>
              <li><a href="https://www.upwork.com/freelancers/ahmadkamrans" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Upwork"><span class="footer-social-monogram" aria-hidden="true">Up</span></a></li>
            </ul>
          </div>
          <%# [[AHMAD: exact registered name, e.g. "Astechware LLC"]] — legal name also in schema/about %>
          <div class="footer-contact small">
            <p class="mb-1"><a href="mailto:ahmad@astechware.com" class="text-decoration-none text-muted">ahmad@astechware.com</a></p>
            <p class="mb-0 text-muted">Book a call: <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="text-decoration-none">Calendly</a></p>
          </div>
        </div>

        <%# Column 2: Services %>
        <div class="col-6 col-md-4 col-lg-2 footer-col footer-services">
          <h3 class="footer-heading">Services</h3>
          <ul class="footer-links list-unstyled m-0">
            <li><%= link_to "AI Agents & Automation", ai_agent_development_path, class: "footer-link" %></li>
            <li><%= link_to "Custom Software, Web & Mobile", custom_software_path, class: "footer-link" %></li>
            <li><%= link_to "MVP Development", mvp_development_path, class: "footer-link" %></li>
            <li><%= link_to "Platform Modernization", platform_modernization_path, class: "footer-link" %></li>
            <li><%= link_to "Integrations & APIs", api_integrations_path, class: "footer-link" %></li>
            <li><%= link_to "Machine Learning", machine_learning_path, class: "footer-link" %></li>
            <li><%= link_to "DevOps & Cloud", devops_engineering_path, class: "footer-link" %></li>
            <li><%= link_to "All services", services_path, class: "footer-link" %></li>
          </ul>
        </div>

        <%# Column 3: Industries %>
        <div class="col-6 col-md-4 col-lg-2 footer-col footer-industries">
          <h3 class="footer-heading">Industries</h3>
          <ul class="footer-links list-unstyled m-0">
            <li><%= link_to "Legal", industry_legal_path, class: "footer-link" %></li>
            <li><%= link_to "Healthcare", industry_healthcare_path, class: "footer-link" %></li>
            <% if route_helper_defined?(:industry_private_clinics_path) %>
              <li><%= link_to "Private Clinics", industry_private_clinics_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:industry_construction_path) %>
              <li><%= link_to "Construction", industry_construction_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:industry_logistics_path) %>
              <li><%= link_to "Logistics & Field Service", industry_logistics_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:industry_home_services_path) %>
              <li><%= link_to "HVAC & Home Services", industry_home_services_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:industry_real_estate_path) %>
              <li><%= link_to "Real Estate", industry_real_estate_path, class: "footer-link" %></li>
            <% end %>
            <li><%= link_to "Fintech", industry_financial_path, class: "footer-link" %></li>
            <li><%= link_to "B2B SaaS", industry_b2b_saas_path, class: "footer-link" %></li>
            <li><%= link_to "EdTech", industry_edtech_path, class: "footer-link" %></li>
            <% if route_helper_defined?(:industry_fitness_studios_path) %>
              <li><%= link_to "Fitness Studios", industry_fitness_studios_path, class: "footer-link" %></li>
            <% end %>
          </ul>
        </div>

        <%# Column 4: Company %>
        <div class="col-6 col-md-4 col-lg-2 footer-col footer-company-links">
          <h3 class="footer-heading">Company</h3>
          <ul class="footer-links list-unstyled m-0">
            <li><%= link_to "About", about_path, class: "footer-link" %></li>
            <li><%= link_to "Client Reviews", reviews_path, class: "footer-link" %></li>
            <li><%= link_to "Case Studies", case_studies_path, class: "footer-link" %></li>
            <% if route_helper_defined?(:hire_ai_engineers_path) %>
              <li><%= link_to "Hire AI Engineers", hire_ai_engineers_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:hire_dedicated_developers_path) %>
              <li><%= link_to "Hire Dedicated Developers", hire_dedicated_developers_path, class: "footer-link" %></li>
            <% end %>
            <% if route_helper_defined?(:integrations_path) %>
              <li><%= link_to "Integrations", integrations_path, class: "footer-link" %></li>
            <% end %>
            <li><%= link_to "Blog", blogs_path, class: "footer-link" %></li>
            <li><%= link_to "GCC", gcc_path, class: "footer-link" %></li>
            <li><%= link_to "Contact", contact_path, class: "footer-link" %></li>
          </ul>
        </div>

        <%# Column 5: Newsletter %>
        <div class="col-12 col-lg-4 col-xl-3 footer-col footer-newsletter">
          <h3 class="footer-heading">Stay informed</h3>
          <p class="footer-newsletter-tagline text-muted small mb-3">
            Get insights on AI, platform engineering, and industry trends.
          </p>
          <%= form_for :form, url: submit_form_path, method: :post, html: { class: "footer-newsletter-form", data: { turbo: false } } do |f| %>
            <%= f.hidden_field :reason, value: "Newsletter" %>
            <%= f.hidden_field :name, value: "Newsletter Subscriber" %>
            <%= f.hidden_field :company_name, value: "" %>
            <%= f.hidden_field :cover_letter, value: "Newsletter signup" %>
            <div class="input-group">
              <%= f.email_field :email, class: "form-control footer-newsletter-input flex-grow-1", placeholder: "Your email", required: true, "aria-label": "Email for newsletter" %>
              <%= f.submit "Subscribe", class: "btn btn-primary footer-newsletter-btn" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Bottom Bar %>
  <div class="footer-bottom">
    <div class="container">
      <div class="row align-items-center py-3">
        <div class="col-12 col-md-4 text-center text-md-start mb-2 mb-md-0">
          <span class="footer-copyright text-muted small">
            © <%= Date.current.year %> A'sTechware. All rights reserved.
          </span>
        </div>
        <div class="col-12 col-md-4 text-center mb-2 mb-md-0">
          <span class="footer-location text-muted small">
            Wyoming, USA · Lahore, Pakistan · Serving clients in the US, UK, Canada and Australia
          </span>
        </div>
        <div class="col-12 col-md-4 text-center text-md-end">
          <ul class="footer-legal list-unstyled d-flex flex-wrap justify-content-center justify-content-md-end gap-3 m-0 small">
            <li><%= link_to "Privacy Policy", privacy_policy_path, class: "footer-legal-link" %></li>
            <li><%= link_to "Terms of Service", terms_of_service_path, class: "footer-legal-link" %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
