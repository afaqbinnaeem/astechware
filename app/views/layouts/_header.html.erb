          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navCompany">
            <li><%= link_to "About", about_path, class: "dropdown-item ajax" %></li>
            <li><%= link_to "Client Reviews", reviews_path, class: "dropdown-item ajax" %></li>
            <li><%= link_to "Contact", contact_path, class: "dropdown-item ajax" %></li>
          </ul>
        </li>
        <li class="enterprise-nav-item enterprise-nav-youtube">
          <a href="https://www.youtube.com/@ahmadkamran518" target="_blank" rel="noopener noreferrer" class="enterprise-youtube-link">
            <i class="fa fa-youtube" aria-hidden="true"></i>
            Watch on YouTube
          </a>
        </li>
        <li class="enterprise-nav-item enterprise-nav-cta">
          <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary rounded-pill px-4 enterprise-cta-btn">
            Book a 30-min call
          </a>
        </li>
        <% if ENV["SKIP_DB"] != "true" && current_user.present? %>
          <li class="enterprise-nav-item"><%= link_to "Dashboard", dashboard_index_path, class: "enterprise-nav-link ajax" %></li>
          <li class="enterprise-nav-item"><%= link_to "Log Out", destroy_user_session_path, class: "enterprise-nav-link ajax" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

