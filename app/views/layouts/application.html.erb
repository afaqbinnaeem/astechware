<%# Rails renders the view BEFORE the layout. Do NOT call set_meta_tags here for defaults —
    that would overwrite page-specific tags set in views. Pass defaults to display_meta_tags
    instead (view set_meta_tags always wins). Capture body so content_for(:head) is available. %>
<% body_content = yield %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Page-specific JSON-LD / extras from views (set_meta_tags already ran during view render) %>
    <%= yield :head %>
    <% if @case_study_seo.present? %>
    <script type="application/ld+json">
    <%= raw(case_study_article_json_ld(@case_study_seo).to_json) %>
    </script>
    <% end %>
    <% og_image_url = seo_og_image_url %>
    <% og_image_type = seo_og_image_type %>
    <% og_image_dims = seo_og_image_dimensions %>
    <% og_meta = {
      title: :full_title,
      description: :description,
      type: 'website',
      site_name: "A'sTechware",
      url: canonical_url,
      image: og_image_url,
      'image:secure_url' => og_image_url,
      'image:type' => og_image_type,
      'image:alt' => "A'sTechware, AI and Platform Engineering. Built for Production."
    } %>
    <% if og_image_dims[:width].present? && og_image_dims[:height].present? %>
      <% og_meta.merge!('image:width' => og_image_dims[:width], 'image:height' => og_image_dims[:height]) %>
    <% end %>
    <%= display_meta_tags(
      reverse: true,
      site: "A'sTechware",
      title: "AI Development Company & Automation Agency",
      description: "AI engineering partner for legal, healthcare, construction, logistics, and operations-heavy teams. Production AI agents, workflow automation, custom software, and dedicated Python, Node.js, and full-stack engineers. Milestone-based delivery, full code ownership.",
      keywords: "AI engineering partner, AI development company, hire software engineers, workflow automation, Python development, Node.js development, legal tech software, healthcare AI, construction software, logistics automation, trucking dispatch software, fractional engineering team, forward deployed engineering, custom automation systems, production AI, platform engineering, AI governance, privacy-first AI",
      og: og_meta,
      twitter: {
        card: 'summary_large_image',
        site: '@astechware',
        image: og_image_url
      }
    ) %>
    <%# Favicon and Site Icon for Google Search Results %>
    <%# Modern SVG favicon (preferred by modern browsers) %>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <%# Standard favicon.ico for older browsers and fallback %>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/favicon.ico" type="image/vnd.microsoft.icon">
    <%# PNG favicons for specific sizes from public directory %>
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <%# Site Icons - Google's preferred format for search results (192x192 and 512x512) %>
    <%# These are critical for Google Search to display your icon %>
    <link rel="icon" type="image/png" sizes="192x192" href="/web-app-manifest-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/web-app-manifest-512x512.png">
    <%# Apple touch icons for iOS devices %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-precomposed.png">
    <%# Web App Manifest - provides metadata for PWA and site icons %>
    <link rel="manifest" href="/site.webmanifest">
    <%# Shortcut icon for older browsers %>
    <link rel="shortcut icon" href="/favicon.ico">
    <!-- <link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"> -->
    <!-- Bootstrap Minified CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <% carousel_lib = content_for(:carousel_libraries).to_s.strip %>
    <%# Slick always in head so Turbo visits to/from home keep $.fn.slick + CSS available %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css">
    <% if carousel_lib == "swiper" %>
    <!-- Swiper (404/500 hero only) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">
    <% end %>

    <!-- Google font Link (Poppins — Netsol-style geometric sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- FontAwesome 4 CDN -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"></script>
    <% if carousel_lib == "swiper" %>
    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <% end %>

    <script src="https://cdn.testly.com/c9b9052f-de73-41e9-9cfa-abf02e50cf1e.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FKTRX5XQV8"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FKTRX5XQV8');
    </script>

    <%# Google reCAPTCHA v3 %>
    <% if recaptcha_site_key.present? %>
    <script>
      window.__RECAPTCHA_SITE_KEY__ = "<%= j recaptcha_site_key %>";
    </script>
    <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptcha_site_key %>" async defer></script>
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_shim_tag %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "application" %>
    <%# Canonical and hreflang %>
    <link rel="canonical" href="<%= canonical_url %>" />
    <link rel="alternate" hreflang="en" href="<%= canonical_url %>" />
    <link rel="alternate" hreflang="x-default" href="<%= canonical_url %>" />
    <%# Preconnect for Core Web Vitals %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <% if asset_path('astechware-transparent-logo.webp').present? %>
    <link rel="preload" as="image" href="<%= asset_path('astechware-transparent-logo.webp') %>" />
    <% end %>

    <%# JSON-LD Organization (all pages, single source) %>
    <script type="application/ld+json">
    <%= raw(organization_json_ld.to_json) %>
    </script>
    <%# BreadcrumbList for non-home pages (blog show has its own in content_for :head) %>
    <% if request.path.present? && request.path != "/" && !request.path.match?(/\A\/blogs\/[^\/]+\z/) %>
    <script type="application/ld+json">
    <%= raw(breadcrumb_list_json_ld) %>
    </script>
    <% end %>

  </head>

  <body class="<%= "case-study-page" if request.path.start_with?("/case-studies/") %>">
    <div id="wrapper" class="site-wrapper">
      <%= render 'layouts/header' %>
      <main id="main-content">
        <%= body_content %>
      </main>
      <%= render 'layouts/footer' %>
    </div>

    <%# Nav, Slick, and Swiper init live in app/javascript/site_ui.js (turbo:load + before-cache). %>

    <%= yield :footer_script %>
    <% if ENV["CHATBOT_NEW"].to_s.downcase == "true" %>
      <%= render 'shared/chat_widget_new' %>
    <% end %>
    <script>
    // Fallback toggle handler in case Stimulus doesn't load (re-bind on Turbo visits).
    // Guard so Turbo re-executing this body script does not stack document listeners.
    if (!window.__astechChatBubbleFallback) {
      window.__astechChatBubbleFallback = true;
      function initChatBubbleFallback() {
        var bubble = document.querySelector('.chat-bubble');
        var chatWindow = document.querySelector('.chat-window');
        if (!bubble || !chatWindow || typeof window.Stimulus !== 'undefined') return;
        if (bubble.dataset.fallbackBound === '1') return;
        bubble.dataset.fallbackBound = '1';
        bubble.addEventListener('click', function() {
          if (bubble.style.display !== 'none') {
            bubble.style.display = 'none';
            chatWindow.style.display = 'flex';
          } else {
            bubble.style.display = 'flex';
            chatWindow.style.display = 'none';
          }
        });
      }
      document.addEventListener('DOMContentLoaded', initChatBubbleFallback);
      document.addEventListener('turbo:load', initChatBubbleFallback);
    }
    </script>
  </body>
</html>
