<% content_for :head do %>
  <% set_meta_tags(
    title: "AI & Software Engineering Blog",
    description: "Practical guides for teams in legal, healthcare, construction, logistics and more: what to automate, what to build, and what it takes to run it every day.",
    keywords: "AI blog, software engineering blog, workflow automation, production AI, platform engineering, technical insights"
  ) %>
<% end %>

<div class="blog-landing inner-sections">
  <!-- Blog Landing Header -->
  <header class="blog-landing-header py-5 bg-light">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-9 mx-auto text-center">
          <h1 class="display-5 fw-bold mb-3" data-page-h1>Blog</h1>
          <p class="lead mb-0" style="max-width: 720px; margin-left: auto; margin-right: auto;">
            Practical guides for teams in legal, healthcare, construction, logistics and more: what to automate, what to build, and what it takes to run it.
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- Featured Article -->
  <section class="py-5 bg-white">
    <div class="container">
      <h2 class="visually-hidden">Featured article</h2>
      <%= render "blogs/blog_featured_card", article: blog_featured_article %>
    </div>
  </section>

  <!-- Category Filter + Main + Sidebar -->
  <section class="py-5 bg-light">
    <div class="container">
      <div class="blog-category-filter mb-4 pb-3 border-bottom">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <a href="<%= blogs_path %>" class="btn btn-outline-secondary btn-sm rounded-pill <%= 'active' if params[:category].blank? %>">All articles</a>
          <% blog_categories_with_posts.each do |slug, cat| %>
            <a href="<%= blogs_path(category: slug) %>" class="btn btn-outline-secondary btn-sm rounded-pill <%= 'active' if params[:category] == slug %>"><%= cat[:name] %></a>
          <% end %>
        </div>
      </div>

      <div class="row">
        <div class="col-12 col-lg-9">
          <div class="row g-4 blog-grid">
            <% blog_index_articles.each do |article| %>
              <div class="col-12 col-md-6 col-lg-4">
                <%= render "blogs/blog_grid_card", article: article %>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-12 col-lg-3 mt-5 mt-lg-0">
          <%= render "blogs/blog_sidebar" %>
        </div>
      </div>
    </div>
  </section>
</div>
