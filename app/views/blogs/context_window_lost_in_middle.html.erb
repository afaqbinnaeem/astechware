<% article = blog_article_for_path(request.path) %>
<% content_for :head do %>
  <% set_meta_tags(
    title: "Lost in the Middle: Why Large Context Windows Aren't Enough | A'sTechware",
    description: "You have a 128K context window but your AI still misses key info. The lost-in-the-middle effect and when RAG beats long context.",
    keywords: "context window, LLM context, lost in the middle, RAG vs long context",
    og: { title: "Lost in the Middle: Why Large Context Windows Don't Solve Everything", description: "The lost-in-the-middle problem and hybrid strategies.", url: safe_request_url, type: "article", site_name: "A'sTechware" },
    twitter: { card: "summary_large_image", title: "Lost in the Middle", description: "Why long context isn't always the answer." }
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Article",
    "headline" => article[:title],
    "description" => article[:excerpt_long],
    "datePublished" => "2025-02-01",
