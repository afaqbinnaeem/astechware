<% if @article.present? %>
  <% content_for :head do %>
    <% canonical_url = blog_show_url(@article[:slug]) rescue request.original_url %>
    <% set_meta_tags(
      title: @article[:title].to_s,
      description: @article[:excerpt_short].to_s.truncate(155),
      keywords: [@article[:category], "A'sTechware", "production AI", "platform engineering", "AI governance", "enterprise AI"].join(", ")
    ) %>
    <% logo_url = safe_og_image_url("logo-colored.png") %>
    <script type="application/ld+json">
    <%= raw({
      "@context" => "https://schema.org",
      "@type" => "Article",
      "headline" => @article[:title],
      "description" => @article[:excerpt_short].to_s.truncate(160),
      "datePublished" => @article[:date],
      "url" => canonical_url,
      "author" => { "@type" => "Person", "name" => "Ahmad" },
      "publisher" => {
        "@type" => "Organization",
        "name" => "A'sTechware",
        "logo" => logo_url.present? ? { "@type" => "ImageObject", "url" => logo_url } : nil
      }.compact
    }.to_json) %>
    </script>
    <script type="application/ld+json">
    <%= raw({
      "@context" => "https://schema.org",
      "@type" => "BreadcrumbList",
      "itemListElement" => [
        { "@type" => "ListItem", "position" => 1, "name" => "Home", "item" => root_url },
        { "@type" => "ListItem", "position" => 2, "name" => "Blog", "item" => blogs_url },
        { "@type" => "ListItem", "position" => 3, "name" => @article[:title], "item" => canonical_url }
      ]
    }.to_json) %>
    </script>
  <% end %>
  <%= render layout: "blogs/blog_post_layout", locals: { article: @article } do %>
    <%= render "blogs/bodies/#{@article[:slug].to_s.tr('-', '_')}" %>
  <% end %>
<% else %>
  <%= render "errors/not_found", status: :not_found %>
<% end %>
