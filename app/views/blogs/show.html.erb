<% if @article.present? %>
  <% content_for :head do %>
    <% blog_og_image = @article[:image].present? ? safe_og_image_url(@article[:image]) : safe_og_image_url("logo-colored.png") %>
    <% set_meta_tags(
      title: "#{@article[:title]} | A'sTechware",
      description: @article[:excerpt_short].to_s.truncate(155),
      keywords: [@article[:category], "A'sTechware", "production AI", "platform engineering", "AI governance", "enterprise AI"].join(", "),
      og: { title: @article[:title], description: @article[:excerpt_short], url: safe_request_url, type: "article", site_name: "A'sTechware" },
      twitter: { card: "summary_large_image", title: @article[:title], description: @article[:excerpt_short] }
    ) %>
    <% set_meta_tags(og: { image: blog_og_image, "image:secure_url" => blog_og_image, "image:type" => "image/png" }, twitter: { image: blog_og_image }) if blog_og_image.present? %>
    <% logo_url = safe_og_image_url("logo-colored.png") %>
    <script type="application/ld+json">
    <%= raw({
      "@context" => "https://schema.org",
      "@type" => "Article",
      "headline" => @article[:title],
      "description" => @article[:excerpt_short].to_s.truncate(160),
      "datePublished" => @article[:date],
      "author" => { "@type" => "Person", "name" => "Ahmad" },
      "publisher" => {
        "@type" => "Organization",
        "name" => "A'sTechware",
        "logo" => logo_url.present? ? { "@type" => "ImageObject", "url" => logo_url } : nil
      }.compact
    }.to_json) %>
    </script>
  <% end %>
  <%= render layout: "blogs/blog_post_layout", locals: { article: @article } do %>
    <%= render "blogs/bodies/#{@article[:slug].to_s.tr('-', '_')}" %>
  <% end %>
<% else %>
  <%= render "errors/not_found", status: :not_found %>
<% end %>
