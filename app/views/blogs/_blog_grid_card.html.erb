<%# locals: article (hash with path, title, category, excerpt_short, date, read_time, image, author_name) %>
<article class="blog-grid-card card h-100 border-0 shadow-sm">
  <%= link_to article[:path].call, class: "text-decoration-none text-dark d-block h-100" do %>
    <div class="blog-grid-card-img position-relative overflow-hidden">
      <%= image_tag article[:image], class: "card-img-top img-fluid", alt: article[:title], loading: "lazy", style: "height: 200px; object-fit: cover;" %>
      <span class="blog-badge blog-badge-<%= article[:category_slug].parameterize %>"><%= article[:category] %></span>
    </div>
    <div class="card-body d-flex flex-column">
      <h3 class="h6 card-title mb-2"><%= article[:title] %></h3>
      <p class="card-text small text-muted flex-grow-1 mb-3"><%= truncate(article[:excerpt_short], length: 100) %></p>
      <div class="d-flex align-items-center justify-content-between small text-muted mb-2">
        <span><%= article[:author_name] %></span>
        <span><%= article[:date] %> · <%= article[:read_time] %></span>
      </div>
      <span class="small fw-semibold text-primary">Read Article →</span>
    </div>
  <% end %>
</article>
