<% article = blog_article_for_path(request.path) %>
<% content_for :head do %>
  <% set_meta_tags(
    title: "Fine Tuning vs Prompting: When Custom Models Beat Prompts | A'sTechware",
    description: "Your legal AI costs $15K/month in API calls. A fine tuned model could pay for itself in 6 months. When and how to decide.",
    keywords: "fine tuning LLMs, custom AI models, prompt engineering vs fine tuning, ROI",
    og: { title: "The Fine Tuning Decision: When Custom Models Beat Prompt Engineering", description: "When to fine tune vs prompt, ROI and data requirements.", url: safe_request_url, type: "article", site_name: "A'sTechware" },
    twitter: { card: "summary_large_image", title: "Fine Tuning vs Prompting", description: "When custom models beat prompt engineering." }
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Article",
    "headline" => article[:title],
    "description" => article[:excerpt_long],
    "datePublished" => "2025 02 01",
    "author" => { "@type" => "Organization", "name" => article[:author_name] }
  }.to_json) %>
  </script>
