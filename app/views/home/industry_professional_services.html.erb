<% content_for :head do %>
  <% set_meta_tags(
    title: "Software for Operations-Heavy Businesses",
    description: "An overview of the software we build for businesses whose work happens in the field and on job sites, with links to each of the industries we serve.",
    keywords: "construction software development, trucking dispatch automation, logistics route optimization, real estate operations software, HVAC field service automation, operations heavy software, field service software"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "Software for Field and Operations-Heavy Businesses",
    "url" => industry_professional_services_url,
    "description" => "An overview of the software we build for businesses whose work happens in the field and on job sites.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => ["United States", "United Kingdom", "Canada", "Australia"],
    "serviceType" => "Field Operations & Dispatch Automation",
    "category" => "Operational Technology"
  }.to_json) %>
  </script>
<% end %>

<div class="hero-section py-5 service-page-hero professional-services-hero industry-landing-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 text-start">
        <h1 class="display-4 fw-bold mb-3" data-page-h1>
          Software for field and operations-heavy businesses
        </h1>
        <p class="fw-semibold mb-3 hero-lead" style="max-width: 36rem">
          AI Driven Dispatching, Route Optimization, and Field Service Automation
        </p>
        <p class="mb-4 hero-lead" style="max-width: 36rem">
          Software for businesses whose work happens in the field and on job sites, with links to each of the industries we serve.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Book a 30-min call
        </a>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections professional-services-industry-page">

  <section class="py-5 bg-white" id="industries">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto mb-5">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Industries we serve</h2>
          <p class="large-para mb-0">
            Software for businesses whose work happens in the field and on job sites. Each card opens the dedicated industry page when it ships.
          </p>
        </div>
      </div>
      <div class="row g-4">
        <% if route_helper_defined?(:industry_construction_path) %>
          <div class="col-12 col-md-6">
            <%= link_to industry_construction_path, class: "workflow-card p-4 p-lg-5 h-100 d-block text-decoration-none text-dark ajax" do %>
              <h3 class="h5 mb-3">Construction</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Estimating, subcontracting, invoicing, and multi-company job site operations.</p>
            <% end %>
          </div>
        <% else %>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 p-lg-5 h-100">
              <h3 class="h5 mb-3">Construction</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Estimating, subcontracting, invoicing, and multi-company job site operations.</p>
            </div>
          </div>
        <% end %>

        <% if route_helper_defined?(:industry_logistics_path) %>
          <div class="col-12 col-md-6">
            <%= link_to industry_logistics_path, class: "workflow-card p-4 p-lg-5 h-100 d-block text-decoration-none text-dark ajax" do %>
              <h3 class="h5 mb-3">Logistics</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Route optimization, dispatch, and fleet orchestration for hauling and delivery ops.</p>
            <% end %>
          </div>
        <% else %>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 p-lg-5 h-100">
              <h3 class="h5 mb-3">Logistics</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Route optimization, dispatch, and fleet orchestration for hauling and delivery ops.</p>
            </div>
          </div>
        <% end %>

        <% if route_helper_defined?(:industry_home_services_path) %>
          <div class="col-12 col-md-6">
            <%= link_to industry_home_services_path, class: "workflow-card p-4 p-lg-5 h-100 d-block text-decoration-none text-dark ajax" do %>
              <h3 class="h5 mb-3">Home services</h3>
              <p class="mb-0 small" style="line-height: 1.7;">HVAC and field service automation, photo to post workflows, and job site proof.</p>
            <% end %>
          </div>
        <% else %>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 p-lg-5 h-100">
              <h3 class="h5 mb-3">Home services</h3>
              <p class="mb-0 small" style="line-height: 1.7;">HVAC and field service automation, photo to post workflows, and job site proof.</p>
            </div>
          </div>
        <% end %>

        <% if route_helper_defined?(:industry_real_estate_path) %>
          <div class="col-12 col-md-6">
            <%= link_to industry_real_estate_path, class: "workflow-card p-4 p-lg-5 h-100 d-block text-decoration-none text-dark ajax" do %>
              <h3 class="h5 mb-3">Real estate</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Showing schedules, transaction coordination, and property operations software.</p>
            <% end %>
          </div>
        <% else %>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 p-lg-5 h-100">
              <h3 class="h5 mb-3">Real estate</h3>
              <p class="mb-0 small" style="line-height: 1.7;">Showing schedules, transaction coordination, and property operations software.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="spotlights">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Featured work</h2>
        <p class="text-muted mb-0">Short teasers. Full stories live on the case study pages and, once they ship, the child industry pages.</p>
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h5 mb-3">Shoreline waste logistics</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Route and dispatch automation for waste hauling operations.</p>
            <%= link_to "Read the case study &rarr;".html_safe, case_study_path("shoreline-waste-logistics"), class: "d-inline-block mt-3 fw-semibold small ajax" %>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h5 mb-3">Construction management platform</h3>
            <p class="mb-0 small" style="line-height: 1.7;">AI estimating, subcontracts, invoicing, and QuickBooks sync for a multi-company builder.</p>
            <%= link_to "Read the case study &rarr;".html_safe, case_study_path("construction-management-platform"), class: "d-inline-block mt-3 fw-semibold small ajax" %>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h5 mb-3">InstaShowing real estate</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Showing schedules and real estate operations automation.</p>
            <%= link_to "Read the case study &rarr;".html_safe, case_study_path("instashowing-real-estate"), class: "d-inline-block mt-3 fw-semibold small ajax" %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%= render "blogs/niche_guides", category_slug: "professional-services" %>

  <section class="py-5 bg-white" id="engage">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto text-center">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">How we engage</h2>
          <p class="large-para mb-4">
            Start with a paid scoping week. We map your field workflows, identify where software actually helps, and give you a phased plan you own.
          </p>
          <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
            Book a 30-min call
          </a>
        </div>
      </div>
    </div>
  </section>

  <%= render "shared/hire_cta" %>

</div>
