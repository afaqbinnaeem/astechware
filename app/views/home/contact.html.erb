<% content_for :head do %>
  <% set_meta_tags(
    title: "Contact Us",
    description: "Book a 30-minute call with founder Ahmad Kamran or send a project message. We reply within one business day for teams in the US, UK, Canada and Australia.",
    keywords: "contact A'sTechware, schedule consultation, hire software engineers, book a call, US UK Canada Australia"
  ) %>
<% end %>
<!-- Hero Section -->
<div class="hero-section contact-portfolio py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" data-page-h1>
          Tell us what&apos;s slowing your team down
        </h1>
        <p class="lead mb-5" style="max-width: 800px; margin-left: auto; margin-right: auto">
          Book a 30-minute call or send us a message. We reply within one business day. We work with teams in the US, UK, Canada and Australia.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">
  <div class="contact-us-section py-5" id="contact_us">
    <div class="container">
      <div class="text-center mb-4">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Tell us about your project</h2>
      </div>
      <%= render "shared/contact_after_touch" %>
      <%= form_for :form, url: submit_form_path, method: :post, class: 'contact-form home-contact-form', data: {turbo: false, remote: true} do |f| %>
      <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-7">
          <%= render "shared/contact_form_fields", f: f, recaptcha_field_id: "g-recaptcha-response-contact", submit_class: "btn btn-primary rounded-pill" %>
        </div>
        <div class="col-12 col-lg-5">
          <%= render "shared/founder_book_box" %>
          <div class="contact-side-card">
            <h3 class="contact-side-title mb-2">Email us</h3>
            <p class="mb-0"><a href="mailto:ahmad@astechware.com">ahmad@astechware.com</a></p>
          </div>
        </div>
      </div>
      <% end %>
    </div>
  </div>
</div>
