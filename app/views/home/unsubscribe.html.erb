<% content_for :head do %>
   <%# Using safe helpers to prevent 500 errors if assets fail %>
   <% og_image = safe_og_image_url('logo-colored.png') %>
   <% if og_image.present? %>
     <% set_meta_tags(
       title: "Unsubscribe | A'sTechware",
       description: "Manage your email subscription preferences with A'sTechware.",
       og: {
         title: "Unsubscribe | A'sTechware",
         description: "Manage your email subscription preferences with A'sTechware.",
         image: og_image,
         'image:secure_url' => og_image,
         'image:type' => 'image/png',
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary_large_image',
         title: "Unsubscribe | A'sTechware",
         description: "Manage your email subscription preferences with A'sTechware.",
         image: og_image
       }
     ) %>
   <% else %>
     <% set_meta_tags(
       title: "Unsubscribe | A'sTechware",
       description: "Manage your email subscription preferences with A'sTechware.",
       og: {
         title: "Unsubscribe | A'sTechware",
         description: "Manage your email subscription preferences with A'sTechware.",
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary',
         title: "Unsubscribe | A'sTechware",
         description: "Manage your email subscription preferences with A'sTechware."
       }
     ) %>
   <% end %>
<% end %>

<!-- Hero Section -->
<div class="hero-section py-5">
   <div class="container">
      <div class="row align-items-center min-vh-50">
         <div class="col-12 col-lg-8 mx-auto text-center">
            <div class="workflow-card p-5">
               <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Subscription Management</h2>
               <p class="mb-5" style="font-size: 18px; line-height: 1.8;">
                  Click the button below to manage your email subscription preferences.
               </p>
               <div class="centered-div">
                  <button id="subscription-toggle-btn" class="btn btn-primary btn-lg rounded-pill px-5">
                     Unsubscribe
                  </button>
               </div>
               <p id="subscription-status" class="mt-4 mb-0" style="font-size: 16px; line-height: 1.6; color: #666; display: none;">
                  You have successfully unsubscribed from our emails.
               </p>
            </div>
         </div>
      </div>
   </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('subscription-toggle-btn');
    
    toggleBtn.addEventListener('click', function() {
      // Extract email from current URL query parameters
      const urlParams = new URLSearchParams(window.location.search);
      const email = urlParams.get('email');
      
      // Always navigate to unsubscribe_me route, let server handle validation
      if (email) {
        window.location.href = '/unsubscribe_me?email=' + encodeURIComponent(email);
      } else {
        window.location.href = '/unsubscribe_me';
      }
    });
  });
</script>
