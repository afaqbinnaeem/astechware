<%# [[AHMAD: launch Fitness Studios now, yes/no]] — page kept until confirmed no %>
<% fitness_faq = [
       { q: "What have you built for fitness studios?", a: "A branded booking app with an AI instructor, plus membership, scheduling and member experience systems for studio operators." },
       { q: "Do you only build for one studio brand?", a: "No. We build custom membership, scheduling and member experience systems for studio and boutique gym operators." },
       { q: "Who is this for?", a: "Fitness studio owners, boutique gym operators, and founders building studio software in the US, UK, Canada, and Australia." },
       { q: "Can you include an AI instructor?", a: "Yes. We build branded booking experiences with an AI instructor when it fits how your studio coaches members." }
     ] %>

<% content_for :head do %>
  <% set_meta_tags(
    title: "Fitness Studio Software",
    description: "Custom software for fitness studios and boutique gyms: branded booking apps with an AI instructor, membership and scheduling for the US, UK, Canada and Australia.",
    keywords: "fitness studio software, boutique gym software, fitness studio platform, studio membership software, branded booking app, class booking software"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "Fitness Studio Software",
    "url" => industry_fitness_studios_url,
    "description" => "Custom software for fitness studios and boutique gyms: branded booking apps with an AI instructor, membership and scheduling.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => ["United States", "United Kingdom", "Canada", "Australia"],
    "serviceType" => "Fitness Studio Software Development",
    "category" => "Fitness Technology"
  }.to_json) %>
  </script>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "FAQPage",
    "mainEntity" => fitness_faq.map { |item|
      {
        "@type" => "Question",
        "name" => item[:q],
        "acceptedAnswer" => { "@type" => "Answer", "text" => item[:a] }
      }
    }
  }.to_json) %>
  </script>
<% end %>

<div class="hero-section py-5 service-page-hero professional-services-hero industry-landing-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 text-start">
        <h1 class="display-4 fw-bold mb-3" data-page-h1>
          Software for fitness studios and boutique gyms
        </h1>
        <p class="text-white fw-semibold mb-3 hero-lead" style="max-width: 36rem">
          Branded booking app with an AI instructor
        </p>
        <p class="mb-4 hero-lead" style="max-width: 36rem; color: rgba(255,255,255,0.95)">
          Custom membership, scheduling, and member experience systems for studio operators in the US, UK, Canada, and Australia&nbsp;&mdash; built to run day to day operations, not just look good in a demo.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Book a 30-min call
        </a>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections fitness-studios-industry-page">

  <section class="py-5 bg-white" id="problems">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto mb-5">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Problems we solve</h2>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">Membership and billing friction</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Plans, pauses, upgrades, and failed payments get handled in spreadsheets or disconnected tools. Staff chase members instead of coaching them.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">Class booking that breaks at peak hours</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Waitlists, no-shows, and capacity rules are hard to keep consistent when front desk tools and mobile booking disagree.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">Member experience split across apps</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Scheduling in one product, payments in another, messaging in a third. Members and staff lose context every time they switch tools.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">Off-the-shelf tools that do not fit boutique ops</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Generic gym software forces workarounds for boutique formats, multi-location rules, and studio-specific packaging.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">No path from ops data to decisions</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Owners cannot see retention, class fill rates, or instructor load without exporting and rebuilding reports every week.</p>
          </div>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="workflow-card p-4 h-100">
            <h3 class="h6 mb-2">Launch risk on a new studio product</h3>
            <p class="mb-0 small" style="line-height: 1.7;">Founders need a production platform with real payments and scheduling, not a clickable prototype that fails on day one of open enrollment.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="featured-build">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Featured build</h2>
          <div class="workflow-card p-4 p-lg-5">
            <h3 class="h5 mb-3">Branded booking app with an AI instructor</h3>
            <p class="mb-3" style="line-height: 1.7;">
              We build branded booking experiences with an AI instructor for studio operators who want membership, scheduling and coaching support in one product.
            </p>
            <p class="mb-0 small text-muted" style="line-height: 1.7;">
              If you run a studio or are building studio software and want the same production approach, we can scope a build around your brand and workflow.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="what-we-build">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto mb-5">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">What we build for studios</h2>
        </div>
      </div>
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <ul class="service-page-list mb-0">
            <li>Branded booking apps with an AI instructor</li>
            <li>Membership, billing and class scheduling</li>
            <li>Member portals and staff tools</li>
            <li>Integrations with payments and messaging</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <%= render "blogs/niche_guides", category_slug: "fitness" %>

  <section class="py-5 bg-light-grey" id="faqs">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Frequently asked questions</h2>
      </div>
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <div class="accordion" id="fitnessFaqAccordion">
            <% fitness_faq.each_with_index do |item, idx| %>
              <% collapse_id = "fitfaq#{idx + 1}" %>
              <div class="accordion-item border rounded mb-2">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#<%= collapse_id %>" aria-expanded="false" aria-controls="<%= collapse_id %>"><%= item[:q] %></button>
                </h3>
                <div id="<%= collapse_id %>" class="accordion-collapse collapse" data-bs-parent="#fitnessFaqAccordion">
                  <div class="accordion-body"><%= item[:a] %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%= render "shared/related_links", page_key: "solutions/fitness-studios" %>

  <section class="py-5 bg-white">
    <div class="container text-center">
      <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
        Book a 30-min call
      </a>
    </div>
  </section>
</div>
