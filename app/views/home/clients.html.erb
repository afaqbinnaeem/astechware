<% content_for :head do %>
  <% set_meta_tags(
    title: "Client Feedback & Testimonials | A'sTechware",
    description: "Feedback and testimonials from teams we've partnered with across SaaS, marketplaces, healthcare, real estate, and more. Production AI and platform engineering.",
    keywords: "client testimonials, A'sTechware reviews, production AI, custom software development, case studies",
    og: { title: "Client Feedback | A'sTechware", description: "Testimonials from teams we've partnered with across SaaS, healthcare, real estate.", url: safe_request_url, type: 'website', site_name: "A'sTechware" },
    twitter: { card: 'summary', title: "Client Feedback | A'sTechware", description: "Testimonials from teams we've partnered with." }
  ) %>
<% end %>
<!-- Hero Section -->
<div class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4"
            style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
          Client Feedback
        </h1>
        <p class="lead mb-0"
           style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">
          Feedback and testimonials from teams we’ve partnered with across SaaS, marketplaces, healthcare, real estate, and more.
        </p>
      </div>
    </div>
  </div>
</div>

