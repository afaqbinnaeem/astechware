<% content_for :head do %>
  <% set_meta_tags(
    title: "Client Reviews & Testimonials | A'sTechware",
    description: "Read verified 5-star reviews of A'sTechware from founders and teams across the US, Germany, Canada, and Australia. AI agents, custom platforms, and integrations, rated on Upwork and LinkedIn.",
    keywords: "A'sTechware reviews, client testimonials, Upwork reviews, software development reviews, AI development agency reviews, custom software testimonials",
    og: { title: "Client Reviews & Testimonials | A'sTechware", description: "Verified 5-star feedback from founders and teams we've partnered with, across SaaS, healthcare, fintech, real estate, and logistics.", url: safe_request_url, type: 'website', site_name: "A'sTechware" },
    twitter: { card: 'summary', title: "Client Reviews & Testimonials | A'sTechware", description: "Verified 5-star feedback from founders and teams we've partnered with." }
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Organization",
    "@id" => "#{base_url}/#organization",
    "name" => "A'sTechware",
    "url" => base_url,
    "aggregateRating" => {
      "@type" => "AggregateRating",
      "ratingValue" => "5.0",
      "bestRating" => "5",
      "worstRating" => "1",
      "reviewCount" => reviews.length.to_s
    },
    "review" => reviews.map do |r|
      {
        "@type" => "Review",
        "author" => { "@type" => "Person", "name" => r[:name] },
        "reviewBody" => r[:text],
        "reviewRating" => { "@type" => "Rating", "ratingValue" => "5", "bestRating" => "5", "worstRating" => "1" }
      }
    end
  }.to_json) %>
  </script>
<% end %>

<!-- Hero Section -->
<div class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4"
            style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
          Client Reviews &amp; Testimonials
        </h1>
        <p class="lead mb-4"
           style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">
          Verified feedback from founders and teams we&apos;ve partnered with, across SaaS, marketplaces, healthcare, fintech, real estate, and logistics.
        </p>
        <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
          <span class="fs-4 text-warning" role="img" aria-label="Rated 5 out of 5 stars">
            <i class="fa fa-star" aria-hidden="true"></i>
            <i class="fa fa-star" aria-hidden="true"></i>
            <i class="fa fa-star" aria-hidden="true"></i>
            <i class="fa fa-star" aria-hidden="true"></i>
            <i class="fa fa-star" aria-hidden="true"></i>
          </span>
          <span class="text-muted fw-semibold">5.0 average &middot; <%= reviews.length %>+ verified reviews on Upwork &amp; LinkedIn</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reviews Grid -->
<div class="py-5 bg-light" id="client_reviews">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">What Clients Say</h2>
      <p class="large-para mb-0">Every review below is from a real engagement, verifiable on Upwork or LinkedIn.</p>
    </div>
    <div class="row g-4">
      <% reviews.each do |review| %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center">
                  <% if review[:image].present? %>
                    <%= image_tag review[:image], class: 'rounded-circle me-3', alt: review[:image_alt], style: 'width:64px;height:64px;object-fit:cover;', loading: "lazy" %>
                  <% else %>
                    <div class="rounded-circle me-3 d-flex align-items-center justify-content-center bg-secondary text-white flex-shrink-0" style="width:64px;height:64px;" aria-hidden="true"><i class="fa fa-user fa-2x"></i></div>
                  <% end %>
                  <div>
                    <h3 class="h5 mb-0"><%= review[:name] %></h3>
                    <small class="text-muted"><%= review[:role] %></small>
                  </div>
                </div>
                <span class="badge bg-light text-dark border"><%= review[:location] %></span>
              </div>
              <div class="text-warning mb-2" role="img" aria-label="5 out of 5 stars">
                <i class="fa fa-star" aria-hidden="true"></i>
                <i class="fa fa-star" aria-hidden="true"></i>
                <i class="fa fa-star" aria-hidden="true"></i>
                <i class="fa fa-star" aria-hidden="true"></i>
                <i class="fa fa-star" aria-hidden="true"></i>
              </div>
              <p class="mb-3 flex-grow-1"><%= review[:text] %></p>
              <p class="mb-0 mt-auto pt-2 border-top small text-muted">
                <a href="<%= review[:source_url] %>" target="_blank" rel="noopener noreferrer" class="service-card-link">Verified on <%= review[:source] %></a>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Where to verify -->
<div class="py-5 bg-white">
