<%# Reusable Industry Landing Page. Pass local: industry (Hash) %>
<%# Keys: name, meta_description, hero_headline, hero_description, hero_cta_text, hero_cta_url, challenges_title, challenges_list[], solutions_title, solutions_list[], benefits_title, benefits_list[], case_studies[], tech_stack_title, tech_stack_list[], compliance_title, compliance_list[], cta_heading, cta_subheading %>
<% cta_url = industry[:hero_cta_url].presence || "https://calendly.com/ahmadkamran/new-meeting" %>

<!-- Hero -->
<div class="hero-section py-5 industry-landing-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
          <%= industry[:hero_headline] %>
        </h1>
        <p class="lead mb-4" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">
          <%= industry[:hero_description] %>
        </p>
        <a href="<%= cta_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          <%= industry[:hero_cta_text].presence || "Schedule Consultation" %>
        </a>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections industry-landing-body">

  <% if industry[:challenges_list].present? %>
  <!-- Industry Challenges -->
  <div class="py-5 bg-white" id="challenges">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block"><%= industry[:challenges_title].presence || "Challenges We Help Solve" %></h2>
          <div class="row g-3">
            <% Array(industry[:challenges_list]).each do |item| %>
              <div class="col-12 col-sm-6 col-lg-3">
                <div class="industry-challenge-card p-3 h-100">
                  <i class="fa fa-exclamation-circle industry-challenge-icon" aria-hidden="true"></i>
                  <span><%= item %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <% if industry[:solutions_list].present? %>
  <!-- Our Solutions Grid -->
  <div class="py-5 bg-light-grey" id="solutions">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block"><%= industry[:solutions_title] %></h2>
        <p class="large-para mb-0" style="max-width: 700px; margin: 0 auto;">Services we deliver for this industry.</p>
      </div>
      <div class="row g-4">
        <% Array(industry[:solutions_list]).each do |sol| %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="build-system-card p-4 h-100">
              <div class="build-icon-wrapper mb-3">
                <div class="build-icon"><i class="fa <%= sol[:icon].presence || 'fa-cog' %>" aria-hidden="true"></i></div>
              </div>
              <h4 class="mb-2"><%= sol[:title] %></h4>
              <% if sol[:description].present? %>
                <p class="mb-0"><%= sol[:description] %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

  <% if industry[:benefits_list].present? %>
  <!-- Industry-Specific Benefits -->
  <div class="py-5 bg-white" id="benefits">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block"><%= industry[:benefits_title] %></h2>
          <ul class="industry-benefits-list">
            <% Array(industry[:benefits_list]).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <% if industry[:case_studies].present? %>
  <!-- Case Study Spotlight -->
  <div class="py-5 bg-light-grey" id="case-studies">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Case Study Spotlight</h2>
        <p class="large-para mb-0" style="max-width: 700px; margin: 0 auto;">Real projects and outcomes in this industry.</p>
      </div>
      <div class="row g-4">
        <% Array(industry[:case_studies]).each do |cs| %>
          <div class="col-12 col-lg-6">
            <div class="workflow-card p-4 h-100">
              <h4 class="mb-2"><%= cs[:title] %></h4>
              <% if cs[:description].present? %><p class="mb-3"><%= cs[:description] %></p><% end %>
              <% if cs[:outcomes].present? %>
                <ul class="industry-outcomes-list mb-3">
                  <% Array(cs[:outcomes]).each do |o| %><li><%= o %></li><% end %>
                </ul>
              <% end %>
              <% if cs[:link].present? %>
                <a href="<%= cs[:link] %>" class="btn btn-outline-primary btn-sm">Read case study →</a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

  <% if industry[:tech_stack_list].present? %>
  <!-- Technology Stack -->
  <div class="py-5 bg-white" id="technology">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block"><%= industry[:tech_stack_title] %></h2>
          <ul class="industry-tech-list">
            <% Array(industry[:tech_stack_list]).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <% if industry[:compliance_list].present? %>
  <!-- Compliance & Security -->
  <div class="py-5 bg-light-grey" id="compliance">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block"><%= industry[:compliance_title].presence || "Compliance & Security" %></h2>
          <div class="row g-3">
            <% Array(industry[:compliance_list]).each do |item| %>
              <div class="col-12 col-sm-6 col-lg-3">
                <div class="industry-compliance-card p-3 h-100">
                  <i class="fa fa-check-circle industry-compliance-icon" aria-hidden="true"></i>
                  <span><%= item %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <!-- CTA -->
  <div class="py-5 bg-white" id="industry-cta">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-8 mx-auto text-center">
          <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block"><%= industry[:cta_heading].presence || "Ready to Get Started?" %></h2>
          <p class="large-para mb-4"><%= industry[:cta_subheading].presence || "Schedule a consultation to discuss your goals and how we can help." %></p>
          <a href="<%= cta_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
            <%= industry[:hero_cta_text].presence || "Schedule Consultation" %>
          </a>
        </div>
      </div>
    </div>
  </div>

</div>
