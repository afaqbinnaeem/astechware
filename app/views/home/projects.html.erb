  body.open-projects-sidebar .projects-sidebar-wrapper-mobile {
    right: 0;
  }

  .projects-sidebar-wrapper-mobile .projects-sidebar {
    position: relative;
    top: 0;
    margin-bottom: 0;
    border-radius: 0;
    padding: 2rem 1rem;
    box-shadow: none;
    height: 100%;
  }

  /* Projects Sidebar Overlay */
  .projects-sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  body.open-projects-sidebar .projects-sidebar-overlay {
    opacity: 1;
    visibility: visible;
  }

  /* Projects Sidebar Styles */
  .projects-sidebar {
    background: #fff;
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
