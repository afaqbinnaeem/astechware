  .close-line-1 {
    transform: translateY(-50%) rotate(45deg);
  }

  .close-line-2 {
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Active State - Hide Menu, Show Close */
  .projects-nav-button.active .projects-menu-icon {
    opacity: 0;
    transform: scale(0) rotate(-90deg);
  }

  .projects-nav-button.active .projects-close-icon {
    opacity: 1;
