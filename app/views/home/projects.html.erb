      margin-right: 0;
      margin-bottom: 0.5rem;
      white-space: normal;
      min-width: auto;
      width: 100%;
    }

    .projects-nav-button {
      display: block;
    }
  }

  @media (min-width: 992px) {
    .projects-sidebar-toggle {
      display: none;
    }

    .projects-sidebar-overlay {
      display: none;
    }
  }
</style>

<script>
  // Projects Sidebar Toggle Functionality
  document.addEventListener('DOMContentLoaded', function() {
    const projectsNavButton = document.querySelector('.projects-nav-button');
    const bodyTag = document.querySelector('body');
    const projectsSidebarOverlay = document.querySelector('.projects-sidebar-overlay');
    const projectTabButtons = document.querySelectorAll('.project-tab-btn');
    let sidebarCount = 0;

    if (projectsNavButton) {
      projectsNavButton.addEventListener('click', function(event) {
        event.stopPropagation();
        bodyTag.classList.toggle('open-projects-sidebar');
        projectsNavButton.classList.toggle('active');
        sidebarCount = 0;
      });
    }

    // Close sidebar when clicking overlay
    if (projectsSidebarOverlay) {
      projectsSidebarOverlay.addEventListener('click', function() {
        if (bodyTag.classList.contains('open-projects-sidebar')) {
          bodyTag.classList.remove('open-projects-sidebar');
          if (projectsNavButton) {
            projectsNavButton.classList.remove('active');
          }
          sidebarCount = 0;
        }
      });
    }

    // Close sidebar when clicking on a project tab (mobile)
    // Handle both desktop and mobile tab buttons
    const allTabButtons = document.querySelectorAll('.project-tab-btn');
    allTabButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        if (window.innerWidth < 992) {
          if (bodyTag.classList.contains('open-projects-sidebar')) {
            bodyTag.classList.remove('open-projects-sidebar');
            if (projectsNavButton) {
              projectsNavButton.classList.remove('active');
            }
            sidebarCount = 0;
          }
        }
      });
    });

    // Sync mobile and desktop tab buttons
    const syncTabs = function(clickedButton) {
      const targetId = clickedButton.getAttribute('data-bs-target');
      const isMobile = clickedButton.id.includes('-mobile');
      
      if (isMobile) {
        // If mobile tab clicked, activate corresponding desktop tab
        const desktopTab = document.querySelector(`#${clickedButton.id.replace('-mobile', '')}`);
        if (desktopTab) {
          desktopTab.click();
        }
      } else {
        // If desktop tab clicked, activate corresponding mobile tab
        const mobileTab = document.querySelector(`#${clickedButton.id}-mobile`);
        if (mobileTab) {
          mobileTab.click();
        }
      }
    };

    allTabButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        syncTabs(button);
      });
    });

    // Close sidebar when clicking outside (mobile)
    bodyTag.addEventListener('click', function(event) {
      if (bodyTag.classList.contains('open-projects-sidebar') && sidebarCount > 0) {
        const sidebarWrapper = document.querySelector('.projects-sidebar-wrapper');
        const isClickInsideSidebar = sidebarWrapper && sidebarWrapper.contains(event.target);
        const isClickOnToggle = projectsNavButton && projectsNavButton.contains(event.target);
        
        if (!isClickInsideSidebar && !isClickOnToggle) {
          bodyTag.classList.remove('open-projects-sidebar');
          if (projectsNavButton) {
            projectsNavButton.classList.remove('active');
          }
          sidebarCount = 0;
        } else {
          sidebarCount++;
        }
      } else {
        sidebarCount++;
      }
    });

    if (projectsNavButton) {
      projectsNavButton.addEventListener('click', function(event) {
        sidebarCount = 0;
      });
    }
  });
</script>