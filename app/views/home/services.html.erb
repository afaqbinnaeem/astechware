<% content_for :head do %>
  <% set_meta_tags(
    title: "Software Development & Automation Services",
    description: "Custom software, web and mobile apps, automation, AI agents and integrations for teams in the US, UK, Canada and Australia. Milestone delivery, you own the code.",
    keywords: "software development services, automation services, AI agent development, custom software, platform modernization, API integrations, machine learning, DevOps"
  ) %>
  <% services_base = Rails.env.production? ? "https://astechware.com" : root_url.chomp("/") %>
  <% hub = [
       ["AI agents and automation", ai_agent_development_path],
       ["Custom software, web and mobile", custom_software_path],
       ["MVP development", mvp_development_path],
       ["Platform modernization", platform_modernization_path],
       ["Integrations and APIs", api_integrations_path],
       ["Machine learning", machine_learning_path],
       ["DevOps and cloud", devops_engineering_path]
     ] %>
  <% services_list_items = hub.each_with_index.map do |(name, path), index|
       { "@type" => "ListItem", "position" => index + 1, "name" => name, "url" => "#{services_base}#{path}" }
     end %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "CollectionPage",
    "name" => "Software Development & Automation Services",
    "url" => "#{services_base}/services",
    "description" => "Custom software, web and mobile apps, automation, AI agents and integrations for teams in the US, UK, Canada and Australia.",
    "mainEntity" => {
      "@type" => "ItemList",
      "itemListElement" => services_list_items
    }
  }.to_json) %>
  </script>
  <script type="application/ld+json">
  <%= raw(breadcrumb_list_json_ld) %>
  </script>
<% end %>

<div class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;" data-page-h1>
          Software, automation and AI services
        </h1>
        <p class="lead mb-0" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 820px; margin-left: auto; margin-right: auto;">
          Custom software, web and mobile apps, automation and AI for any business, with deep experience in legal, healthcare, construction and logistics.
        </p>
      </div>
    </div>
  </div>
</div>

<section class="py-5 bg-white" id="services">
  <div class="container">
    <div class="row g-4 justify-content-center">
      <% [
        ["AI agents and automation", ["Agents that read documents, calls and email", "A person approves anything that matters", "Built inside the tools you already use"], ai_agent_development_path],
        ["Custom software, web and mobile", ["Portals, dashboards and internal tools", "iOS and Android apps", "You own the code"], custom_software_path],
        ["MVP development", ["From an idea to a first version", "Design, build and test in milestones", "For founders, including non-technical ones"], mvp_development_path],
        ["Platform modernization", ["Fix slow or fragile systems", "Step by step, without downtime", "Weekly demos as we go"], platform_modernization_path],
        ["Integrations and APIs", ["QuickBooks, Stripe, Twilio, Outlook and more", "Data moves without retyping", "Webhooks and error handling"], api_integrations_path],
        ["Machine learning", ["Document reading and classification", "Predictions inside a workflow", "A person reviews what matters"], machine_learning_path],
        ["DevOps and cloud", ["Cloud setup and CI/CD", "Monitoring and alerts", "A security review before launch"], devops_engineering_path]
      ].each do |title, bullets, path| %>
        <div class="col-12 col-md-6 col-lg-4 d-flex">
          <%= link_to path, class: "text-decoration-none text-dark d-flex w-100 ajax what-we-build-card" do %>
            <div class="build-system-card p-4 h-100 w-100">
              <h2 class="h5 mb-3"><%= title %></h2>
              <ul class="mb-3 ps-3">
                <% bullets.each do |bullet| %>
                  <li><%= bullet %></li>
                <% end %>
              </ul>
              <span class="what-we-build-more">See how &rarr;</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= render "home/tools_platforms", section_class: "py-5 bg-light-grey", section_id: "tools" %>

<section class="py-5">
  <div class="container text-center">
    <%= link_to "Book a 30-min call", "https://calendly.com/ahmadkamran/new-meeting", target: "_blank", rel: "noopener noreferrer", class: "btn btn-primary rounded-pill px-4" %>
  </div>
</section>
