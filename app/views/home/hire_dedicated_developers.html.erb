<% content_for :head do %>
  <% set_meta_tags(
    title: "Hire Dedicated Software Developers",
    description: "Dedicated Python, React, Node.js and mobile developers who work in your tools, with senior code review and cover. Month-to-month, you own the code.",
    keywords: "hire dedicated developer, staff augmentation, hire Python developer, hire React developer, hire Node.js developer, dedicated software engineer, team extension"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "Dedicated Software Developers",
    "url" => hire_dedicated_developers_url,
    "description" => "Dedicated Python, React, Node.js and mobile developers who work in your tools, with senior code review and cover. Month-to-month, you own the code.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => ["United States", "United Kingdom", "Canada", "Australia"],
    "serviceType" => "Staff augmentation",
    "category" => "Software Development"
  }.to_json) %>
  </script>
  <script type="application/ld+json">
  <%= raw(hire_faq_json_ld.to_json) %>
  </script>
<% end %>

<div class="hero-section py-5 service-page-hero industry-landing-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-3" data-page-h1>
          Hire dedicated developers
        </h1>
        <p class="text-white fw-semibold mb-4" style="max-width: 720px; margin-left: auto; margin-right: auto">
          One engineer in your tools, backed by a team of 20–25.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Book a 30-min call &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections hire-dedicated-developers-page">

  <section class="py-5 bg-white" id="team-extension">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Team extension, not a black-box vendor</h2>
        <p class="large-para mb-4">
          You keep product ownership. A dedicated developer joins your standups, picks up tickets, and ships in your codebase&mdash;Python and FastAPI services, React and Next.js frontends, Node APIs, React Native mobile, or Rails monoliths you are evolving.
        </p>
        <p class="large-para mb-4">
          When you need a defined scope delivered instead of a seat on the team, we run project delivery with milestones and weekly demos. Many clients use both: a dedicated engineer for the roadmap and project teams for larger builds.
        </p>
        <p class="mb-2 fw-semibold">Related delivery work</p>
        <p class="mb-0">
          <%= link_to "Custom software", custom_software_path, class: "service-card-link ajax" %>
          <span class="text-muted mx-2">&middot;</span>
          <%= link_to "Platform modernization", platform_modernization_path, class: "service-card-link ajax" %>
          <span class="text-muted mx-2">&middot;</span>
          <%= link_to "Word-of-mouth modernization", case_study_path("word-of-mouth-modernization"), class: "service-card-link ajax" %>
          <span class="text-muted mx-2">&middot;</span>
          <%= link_to "Restaurant marketplace rescue", case_study_path("restaurant-resource-rescue"), class: "service-card-link ajax" %>
        </p>
      </div>
    </div>
  </section>

  <%= render "home/hire_shared_sections", accordion_id: "hireDedicatedDevsFaq" %>
</div>