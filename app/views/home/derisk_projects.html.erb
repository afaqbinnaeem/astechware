<script>
   // Handle FAQ accordion icon rotation
   document.addEventListener('DOMContentLoaded', function() {
     const faqAccordion = document.getElementById('faqAccordion');
     
     if (faqAccordion) {
       // Get all collapse elements
       const collapseElements = ['faqCollapse1', 'faqCollapse2', 'faqCollapse3', 'faqCollapse4', 'faqCollapse5'];
       
       collapseElements.forEach(function(collapseId, index) {
         const collapse = document.getElementById(collapseId);
         const iconId = 'faqIcon' + (index + 1);
         const icon = document.getElementById(iconId);
         
         if (collapse && icon) {
           collapse.addEventListener('show.bs.collapse', function() {
             icon.classList.remove('fa-chevron-down');
             icon.classList.add('fa-chevron-up');
             icon.style.transform = 'rotate(180deg)';
           });
           
           collapse.addEventListener('hide.bs.collapse', function() {
             icon.classList.remove('fa-chevron-up');
             icon.classList.add('fa-chevron-down');
             icon.style.transform = 'rotate(0deg)';
           });
         }
       });
     }
   });
</script>

