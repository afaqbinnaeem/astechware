<div class="hero-section py-5 service-page-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-10 mx-auto text-center">
        <h1 class="display-5 fw-bold mb-3" style="font-size: clamp(28px, 4.5vw, 52px); line-height: 1.15;">
          A Canadian Process Serving Company, AI-Powered Legal Process Serving Platform
        </h1>
        <p class="lead fw-semibold mb-3" style="font-size: clamp(18px, 2.3vw, 22px); line-height: 1.5; max-width: 980px; margin-left: auto; margin-right: auto;">
          Multi-Tenant SaaS That Replaces Gmail + Sheets + Apps Script for Process Serving Companies
        </p>
        <p class="mb-0" style="font-size: clamp(16px, 2vw, 18px); line-height: 1.7; max-width: 980px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.95);">
          From law firm email to GPS-tracked delivery to signed affidavit to invoice, fully automated, legally defensible, and white-labelled for any process serving company in Canada.
        </p>
      </div>
