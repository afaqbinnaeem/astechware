<div class="hero-section py-5 service-page-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-10 mx-auto text-center">
        <h1 class="display-5 fw-bold mb-3" style="font-size: clamp(28px, 4.5vw, 52px); line-height: 1.15;">
          GolfPay360 High-Concurrency Booking
        </h1>
        <p class="lead fw-semibold mb-3" style="font-size: clamp(18px, 2.3vw, 22px); line-height: 1.5; max-width: 980px; margin-left: auto; margin-right: auto;">
          Multi-tenant SaaS built to survive peak tee-time spikes
        </p>
        <p class="mb-0" style="font-size: clamp(16px, 2vw, 18px); line-height: 1.7; max-width: 980px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.95);">
          A booking platform engineered for Saturday-morning surges—preventing double-bookings, reducing DB load, and keeping checkout reliable under heavy concurrency.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">
  <section class="py-5 bg-white">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">The Challenge</h2>
        <p class="large-para mb-0">
          Golf courses face extreme traffic spikes (e.g., Saturday at 7:00 AM). Legacy monolithic booking systems crashed under load—causing lost revenue and frustrated members.
        </p>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">The Solution</h2>
        <p class="large-para mb-0">
          We built a modern, multi-tenant SaaS platform with an auto-scaling architecture designed to handle peak demand without downtime.
        </p>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Technical Approach</h2>
        <ul class="service-page-list mb-0" style="font-size: 1.05rem; line-height: 1.8;">
          <li><strong>Race-Condition Prevention:</strong> Redis locking ensures only one booking succeeds when multiple users click the same tee time simultaneously.</li>
          <li><strong>Edge Caching:</strong> Global CDN caching reduces database load by ~90% during high-traffic browsing.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Technical Details</h2>
        <div class="row g-4">
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 h-100">
              <h3 class="h6 text-uppercase text-muted mb-3">Architecture</h3>
              <p class="mb-0 small">Next.js → AWS Lambda → DynamoDB (high-speed key-value lookups)</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 h-100">
              <h3 class="h6 text-uppercase text-muted mb-3">Integrations</h3>
              <p class="mb-0 small">Clover POS (check-ins), Stripe (prepayments), Twilio (SMS reminders).</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 h-100">
              <h3 class="h6 text-uppercase text-muted mb-3">Security</h3>
              <p class="mb-0 small">PCI-compliant payment tokenization; RBAC for course managers vs. pro-shop staff.</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="workflow-card p-4 h-100">
              <h3 class="h6 text-uppercase text-muted mb-3">AI Features</h3>
              <p class="mb-0 small">Dynamic pricing engine suggests price changes using weather + historical demand to maximize revenue.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Results &amp; Impact</h2>
        <ul class="service-page-list mb-0" style="font-size: 1.05rem; line-height: 1.8;">
          <li><strong>84%</strong> of bookings moved from phone calls to online.</li>
          <li><strong>Zero downtime</strong> during peak seasonal surges.</li>
          <li><strong>120+ hours</strong> of manual phone-time saved per course, per month.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto text-center">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Ready to build something similar?</h2>
        <p class="lead mb-4">We’ll design concurrency, inventory locking, and payment flows to survive real peak traffic.</p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5 me-2 mb-2">
          Schedule a Technical Discovery Call
        </a>
        <%= link_to "View our Services", root_path(anchor: "services"), class: "btn btn-outline-primary btn-lg rounded-pill px-5 mb-2 ajax" %>
      </div>
    </div>
  </section>
</div>

