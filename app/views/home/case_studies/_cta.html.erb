<section class="py-5 bg-white" id="similar">
  <div class="container">
    <div class="col-12 col-lg-8 mx-auto text-center">
      <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Want something similar?</h2>
      <p class="large-para mb-4">
        <%= local_assigns[:blurb].presence || "Tell us what you are building. We will be direct about whether we can help." %>
      </p>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Start a discovery sprint &rarr;
        </a>
        <% if route_helper_defined?(:contact_path) %>
          <%= link_to "Contact us", contact_path, class: "btn btn-outline-primary btn-lg rounded-pill px-5 ajax" %>
        <% end %>
      </div>
    </div>
  </div>
</section>
