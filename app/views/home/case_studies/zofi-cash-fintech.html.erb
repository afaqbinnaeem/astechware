<div class="hero-section py-5 service-page-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 text-start">
        <h1 class="display-5 fw-bold mb-3" data-page-h1>
          Earned wage access app with automated repayment
        </h1>
        <p class="mb-0 hero-lead" style="max-width: 36rem">
          A full stack EWA ecosystem that calculates &ldquo;earned but unpaid&rdquo; wages in real time and settles advances automatically, built for payroll correctness and bank grade security.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">

  <section class="py-5 bg-white" id="problem">
    <div class="container">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-7">
          <h2 class="heading-border heading-center heading-left mb-4 pb-3 d-inline-block">The problem</h2>
          <p class="large-para mb-3">
            In emerging markets, <strong>70% of the workforce</strong> faces high interest predatory lending between pay cycles. Employers needed a way to offer Earned Wage Access (EWA)
            without impacting their own cash flow or creating manual accounting overhead.
          </p>
          <p class="large-para mb-0">
            The technical hurdle was building a real time accrual engine that can calculate &ldquo;unpaid but earned&rdquo; wages across disparate payroll systems with varying tax brackets, while staying
            correct under edge cases (time corrections, partial periods, and payout failures) and keeping HR out of the loop.
          </p>
        </div>
        <div class="col-12 col-lg-5">
          <%= render "home/case_studies/at_a_glance",
            industry: "FinTech / earned wage access",
            client: "Zofi Cash",
            country: "United States (product for Africa)",
            what_we_built: "EWA mobile app with real-time accrual engine and automated payroll settlement",
            integrations: "Plaid/Okra (bank verification), M-Pesa/Airtel Money (disbursement), SAP/Oracle ERP connectors",
            stack: "Flutter, Node.js microservices, PostgreSQL (High Availability RDS)" %>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="what-we-built">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">What we built</h2>
        <p class="large-para mb-3">
          A full stack FinTech ecosystem that enables instant wage withdrawals. We engineered a proprietary accrual logic layer that syncs with employer attendance data to compute a
          &ldquo;Safe to Withdraw&rdquo; limit, preventing over drafting and payroll discrepancies.
        </p>
        <p class="large-para mb-0">
          The platform is designed to be operationally invisible: advances are calculated deterministically (net of taxes and contributions), disbursements are handled through integrated payout
          rails, and settlement is automated via bank/ERP compatible files so HR and payroll do not reconcile transactions manually.
        </p>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="how-it-works">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">How it works</h2>
        <ul class="service-page-list mb-4">
          <li><strong>Deterministic accrual logic:</strong> Formula based engine calculates net pay (after taxes/social contributions) on a per diem basis.</li>
          <li><strong>Automated batch settlement:</strong> Middleware generates ISO 20022 compliant settlement files for employer banking at month end.</li>
          <li><strong>Architecture:</strong> Flutter (Mobile) &rarr; Node.js (Microservices) &rarr; PostgreSQL (High Availability RDS).</li>
          <li><strong>Integrations:</strong> Plaid/Okra (bank verification), M Pesa/Airtel Money (disbursement), SAP/Oracle ERP connectors.</li>
          <li><strong>Security:</strong> KYC/AML screening via Jumio, AES 256 encryption, and multi factor authentication (MFA).</li>
          <li><strong>AI features:</strong> Repayment predictor adjusts risk based withdrawal limits using attendance and withdrawal frequency signals.</li>
        </ul>
      </div>
    </div>
  </section>

  <%= render "home/case_studies/demo_walkthrough", youtube_id: "EkNUzDFSpMY", iframe_title: "ZofiCash salary advance fintech demo" %>

  <section class="py-5 bg-light-grey" id="results">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Results</h2>
        <ul class="service-page-list mb-0">
          <li><strong>High adoption</strong> supported by a reliable withdrawal and settlement experience.</li>
          <li><strong>Strong repayment</strong> through at source payroll deductions and configurable risk controls.</li>
          <li><strong>Zero manual HR work</strong> across the advance to repayment lifecycle.</li>
        </ul>
      </div>
    </div>
  </section>

  <%= render "home/case_studies/gallery", slug: "zofi-cash-fintech" %>
  <%= render "home/case_studies/client_quote", slug: "zofi-cash-fintech" %>
  <%= render "home/case_studies/cta", blurb: "We&rsquo;ll design your payout + payroll settlement flows for correctness, auditability, and scale." %>

  <section class="py-4 bg-white">
    <div class="container text-center">
      <%= link_to "Financial services software →", industry_financial_path, class: "service-card-link ajax" %>
    </div>
  </section>

</div>