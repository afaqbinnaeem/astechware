<div class="hero-section py-5 service-page-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-10 mx-auto text-center">
        <h1 class="display-5 fw-bold mb-3" style="font-size: clamp(28px, 4.5vw, 52px); line-height: 1.15;">
          Autonomous Patient Engagement &amp; Triage System
        </h1>
        <p class="lead fw-semibold mb-3" style="font-size: clamp(18px, 2.3vw, 22px); line-height: 1.5; max-width: 900px; margin-left: auto; margin-right: auto;">
          Medical Voice AI &amp; Clinical Triage (HIPAA-Compliant)
        </p>
        <p class="mb-0" style="font-size: clamp(16px, 2vw, 18px); line-height: 1.7; max-width: 980px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.95);">
          A high-fidelity Voice AI orchestration layer that automates patient intake, clinical triage, and scheduling—built to survive real call volume while meeting HIPAA/HITECH safeguards.
        </p>
