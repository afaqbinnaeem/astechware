<% content_for :head do %>
   <%# Using safe helpers to prevent 500 errors if assets fail %>
   <% og_image = safe_og_image_url('logo-colored.png') %>
   <% if og_image.present? %>
     <% set_meta_tags(
       title: "Privacy Policy | A'sTechware",
       description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services.",
       og: {
         title: "Privacy Policy | A'sTechware",
         description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services.",
         image: og_image,
         'image:secure_url' => og_image,
         'image:type' => 'image/png',
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary_large_image',
         title: "Privacy Policy | A'sTechware",
         description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services.",
         image: og_image
       }
     ) %>
   <% else %>
     <% set_meta_tags(
       title: "Privacy Policy | A'sTechware",
       description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services.",
       og: {
         title: "Privacy Policy | A'sTechware",
         description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services.",
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary',
         title: "Privacy Policy | A'sTechware",
         description: "Privacy Policy for Astechware. Learn how we collect, use, and protect your information when you visit our website or interact with our services."
       }
     ) %>
   <% end %>
<% end %>

<!-- Hero Section -->
<div class="hero-section py-5">
   <div class="container">
      <div class="row align-items-center min-vh-50">
         <div class="col-12 col-lg-8 mx-auto text-center">
            <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
               Privacy Policy
            </h1>
            <p class="lead mb-5" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">
               Last updated: January 2026
            </p>
         </div>
      </div>
   </div>
</div>

<div class="inner-sections">
   <div class="bg-light-grey">
      <div class="container py-5">
         <div class="row">
            <div class="col-12 col-lg-10 mx-auto">
               <div class="mb-5">
                  <p class="large-para mb-4" style="font-size: 18px; line-height: 1.8;">
                     A'sTechware (&ldquo;we&rdquo;, &ldquo;our&rdquo;, &ldquo;us&rdquo;) operates https://astechware.com. This Privacy Policy explains how we collect, use, and protect your information when you visit our website or interact with our services.
                  </p>
               </div>

               <!-- Information We Collect -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Information We Collect</h2>
                  <div class="workflow-card p-4 mb-4">
                     <p class="mb-4" style="font-size: 18px; line-height: 1.8;">
                        We collect only the information necessary to operate our website and communicate with you.
                     </p>
                     
                     <h3 class="h4 mb-3">Information you provide directly</h3>
                     <ul class="mb-4" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>Name</li>
                        <li>Email address</li>
                        <li>Company name</li>
                        <li>Message or inquiry details</li>
                     </ul>
                     <p class="mb-4" style="font-size: 18px; line-height: 1.8;">
                        (when you contact us via forms, email, or demos)
                     </p>

                     <h3 class="h4 mb-3">Information collected automatically</h3>
                     <ul class="mb-4" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>IP address</li>
                        <li>Browser type and device information</li>
                        <li>Pages visited and basic usage data</li>
                     </ul>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        This data is collected through standard analytics and server logs to understand how our site is used and to improve performance.
                     </p>
                  </div>
               </div>

               <!-- How We Use Your Information -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">How We Use Your Information</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-3" style="font-size: 18px; line-height: 1.8;">
                        We use your information to:
                     </p>
                     <ul class="mb-4" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>Respond to inquiries or demo requests</li>
                        <li>Communicate about our services or projects</li>
                        <li>Improve our website and offerings</li>
                        <li>Maintain security and prevent abuse</li>
                     </ul>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8; font-weight: 600;">
                        We do not sell, rent, or trade your personal information.
                     </p>
                  </div>
               </div>

               <!-- Emails & Communications -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Emails &amp; Communications</h2>
                  <div class="workflow-card p-4">
                     <ul class="mb-0" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>If you contact us, we may reply via email.</li>
                        <li>We may send occasional service-related communications only when relevant to your inquiry.</li>
                        <li>We do not send unsolicited marketing emails.</li>
                     </ul>
                  </div>
               </div>

               <!-- Cookies & Analytics -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Cookies &amp; Analytics</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-3" style="font-size: 18px; line-height: 1.8;">
                        We may use basic cookies or analytics tools to:
                     </p>
                     <ul class="mb-4" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>Understand website traffic</li>
                        <li>Improve usability and performance</li>
                     </ul>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        You can disable cookies through your browser settings.
                     </p>
                  </div>
               </div>

               <!-- Data Sharing -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Data Sharing</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-3" style="font-size: 18px; line-height: 1.8;">
                        We may share limited data with trusted third-party service providers only when necessary to operate our website or communication tools (such as email delivery or analytics services).
                     </p>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        These providers are required to protect your information and use it only for the intended purpose.
                     </p>
                  </div>
               </div>

               <!-- Data Security -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Data Security</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        We take reasonable technical and organizational measures to protect your information. However, no method of transmission over the internet is completely secure, and we cannot guarantee absolute security.
                     </p>
                  </div>
               </div>

               <!-- Third-Party Links -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Third-Party Links</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        Our website may contain links to third-party websites. We are not responsible for the privacy practices or content of those sites.
                     </p>
                  </div>
               </div>

               <!-- Your Rights -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Your Rights</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-3" style="font-size: 18px; line-height: 1.8;">
                        You may request to:
                     </p>
                     <ul class="mb-4" style="font-size: 18px; line-height: 1.8; padding-left: 1.5rem;">
                        <li>Access the personal data we hold about you</li>
                        <li>Correct or delete your information</li>
                     </ul>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        To do so, contact us using the email below.
                     </p>
                  </div>
               </div>

               <!-- Changes to This Policy -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Changes to This Policy</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        We may update this Privacy Policy from time to time. Updates will be posted on this page with a revised date.
                     </p>
                  </div>
               </div>

               <!-- Contact -->
               <div class="mb-5">
                  <h2 class="heading-border mb-4 pb-3 text-start">Contact</h2>
                  <div class="workflow-card p-4">
                     <p class="mb-3" style="font-size: 18px; line-height: 1.8;">
                        If you have questions about this Privacy Policy or your data, contact:
                     </p>
                     <p class="mb-2" style="font-size: 18px; line-height: 1.8;">
                        <strong>Email:</strong> <a class="linkedIn-tag ms-2" href="mailto:ahmad@astechware.com">ahmad@astechware.com</a>
                     </p>
                     <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
                        <strong>Website:</strong> <a class="linkedIn-tag ms-2" href="https://astechware.com" target="_blank" rel="noopener noreferrer">https://astechware.com</a>
                     </p>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
