      font-size: 18px;
      cursor: pointer;
      padding: 5px 8px;
      line-height: 1;
      transition: all 0.2s;
      border-radius: 4px;
   }

   .popup-close:hover {
      color: var(--text-color);
      background: #f8f9fa;
   }

   .popup-body {
      padding-right: 25px;
   }

   .popup-text {
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-color);
      margin: 0;
   }

   .popup-text strong {
      color: var(--text-color);
      font-weight: 600;
   }

   .popup-link {
      color: var(--site-color);
      # text-decoration: underline;
      font-weight: 600;
      transition: all 0.2s;
      border-bottom: 1px solid var(--text-color);
   }

   .popup-link:hover {
      color: var(--site-color-hover);
      border-bottom-color: var(--site-color);
   }

   @media (max-width: 768px) {
      .dev-experience-popup {
         max-width: calc(100% - 40px);
         bottom: 15px;
         right: 15px;
         left: 15px;
      }
   }
</style>

<script>
   document.addEventListener('DOMContentLoaded', function() {
      const popup = document.getElementById('devExperiencePopup');
      const closeBtn = document.getElementById('closePopup');
      
      // Show popup after 2 seconds
      setTimeout(function() {
         if (popup) {
            popup.classList.add('show');
         }
      }, 2000);
      
      // Close popup on button click
      if (closeBtn) {
         closeBtn.addEventListener('click', function() {
            if (popup) {
               popup.classList.remove('show');
            }
         });
      }
      
      // Close popup when clicking outside (optional)
      document.addEventListener('click', function(e) {
         if (popup && popup.classList.contains('show')) {
            if (!popup.contains(e.target) && !e.target.closest('.dev-experience-popup')) {
            }
         }
      });
   });
</script>