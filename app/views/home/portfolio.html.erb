    border-radius: 14px;
    border: 1px solid #e9ecef;
    box-shadow: 0 2px 14px rgba(15, 23, 42, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .case-study-tile-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.12);
    border-color: var(--site-color);
  }

  .case-study-tile.is-hidden {
    display: none !important;
  }
</style>

<script>
  function initCaseStudiesFiltering() {
    const grid = document.getElementById('caseStudiesGrid');
    if (!grid) return;

    const buttons = Array.from(document.querySelectorAll('.case-filter-btn'));
    const tiles = Array.from(grid.querySelectorAll('.case-study-tile'));

    function setActiveButton(activeBtn) {
      buttons.forEach((btn) => {
        const isActive = btn === activeBtn;
        btn.classList.toggle('is-active', isActive);
        btn.classList.toggle('btn-primary', isActive);
        btn.classList.toggle('btn-outline-primary', !isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function applyFilter(filter) {
      tiles.forEach((tile) => {
        const categories = (tile.getAttribute('data-categories') || '').split(/\s+/).filter(Boolean);
        const shouldShow = filter === 'all' ? true : categories.includes(filter);
        tile.classList.toggle('is-hidden', !shouldShow);
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        setActiveButton(btn);
        applyFilter(filter);
      });
    });

    // Default
    const defaultBtn = buttons.find((b) => b.getAttribute('data-filter') === 'all') || buttons[0];
    if (defaultBtn) {
      setActiveButton(defaultBtn);
      applyFilter('all');
    }
  }

  document.addEventListener('DOMContentLoaded', initCaseStudiesFiltering);
  document.addEventListener('turbo:load', initCaseStudiesFiltering);
</script>