<script>
  function initCaseStudiesPage() {
    const popup = document.getElementById('devExperiencePopup');
    const closeBtn = document.getElementById('closePopup');

    // Show popup after 2 seconds
    setTimeout(function() {
      if (popup) {
        popup.classList.add('show');
      }
    }, 2000);

    // Close popup on button click
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (popup) {
          popup.classList.remove('show');
        }
      });
    }

    // Close popup when clicking outside (optional)
    document.addEventListener('click', function(e) {
      if (popup && popup.classList.contains('show')) {
        if (!popup.contains(e.target) && !e.target.closest('.dev-experience-popup')) {
        }
      }
    });

    // Smooth scrolling to case study anchors with offset
    const hash = window.location.hash;
    const SCROLL_OFFSET = 120; // keep section a bit higher on screen
    const SCROLL_DURATION = 900; // slower scroll (ms)

    function smoothScrollToTarget(target) {
      const startY = window.pageYOffset;
      const targetRect = target.getBoundingClientRect();
      const targetY = targetRect.top + window.pageYOffset - SCROLL_OFFSET;
      const distance = targetY - startY;
      const startTime = performance.now();

      function step(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / SCROLL_DURATION, 1);
        // easeInOut
        const ease = 0.5 * (1 - Math.cos(Math.PI * progress));
        window.scrollTo(0, startY + distance * ease);
        if (progress < 1) {
          requestAnimationFrame(step);
        }
      }

      requestAnimationFrame(step);
    }

    if (hash) {
      const target = document.querySelector(hash);
      if (target) {
        // Start from top, then animate down with offset
        window.scrollTo(0, 0);
        setTimeout(function() {
          smoothScrollToTarget(target);
        }, 50);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initCaseStudiesPage);
  document.addEventListener('turbo:load', initCaseStudiesPage);
</script>