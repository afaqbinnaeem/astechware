<style>
   .dev-experience-popup {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 9999;
      max-width: 380px;
      opacity: 0;
      transform: translateX(100%);
      transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      pointer-events: none;
   }

   .dev-experience-popup.show {
      opacity: 1;
      transform: translateX(0);
      pointer-events: all;
   }

   .popup-content {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
      padding: 20px;
