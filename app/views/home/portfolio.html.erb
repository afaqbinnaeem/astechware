<!-- Hero Section -->
<div class="hero-section hero-portfolio py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 54px); line-height: 1.15;">
          B2B SaaS AI Case Studies. Real Deployments, Real ROI.
        </h1>
        <p class="lead mb-0" style="font-size: clamp(18px, 2.3vw, 22px); line-height: 1.6; max-width: 860px; margin-left: auto; margin-right: auto;">
          We build production‑grade platforms first, then layer automation and AI where it actually removes friction and drives revenue.
          Every case below reflects real constraints, real trade‑offs, and measurable results.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">
  <div class="bg-light-grey">
    <div class="container py-5">
      <div class="row">
        <div class="col-12 col-lg-11 mx-auto port-main">

          <!-- Case Studies (8-section template) -->
          <section class="case-study-section mb-5" aria-label="Case studies">
            <% if @case_studies.present? %>
              <% @case_studies.each do |case_study| %>
                <%= render 'case_study_detail', case_study: case_study %>
              <% end %>
            <% end %>
          </section>


          <!-- PATTERN ACROSS PROJECTS -->
          <section class="case-study-section mb-5">
            <div class="case-study-card">
              <h2 class="h3 fw-bold mb-3">The Pattern Across Every Project</h2>
              <p class="mb-3">
                None of these started with “Let’s add AI.”
                They started with:
              </p>
              <ul class="bullet-list mb-3">
                <li>Broken operations</li>
                <li>Manual bottlenecks</li>
                <li>Lost revenue</li>
                <li>Overworked teams</li>
              </ul>
              <p>Our approach is consistent:</p>
              <ol>
                <li><strong>Build or fix the platform</strong> ,  Stable foundation first</li>
                <li><strong>Deploy AI with governance</strong> ,  Production-ready systems, not prototypes</li>
                <li><strong>Measure results in money & time</strong> ,  ROI tracking from day one</li>
                <li><strong>Iterate based on real usage</strong> ,  Continuous improvement with human feedback</li>
              </ol>

              <h4 class="h5 fw-bold mt-4 mb-3">Every AI System Includes:</h4>
              <ul class="bullet-list">
                <li><strong>Human-in-the-loop protocols</strong> for critical decisions and edge cases</li>
                <li><strong>Complete audit trails</strong> logging every AI decision and data access</li>
                <li><strong>Observability dashboards</strong> with real-time monitoring and alerts</li>
                <li><strong>Compliance frameworks</strong> aligned with industry requirements (HIPAA, SOC 2, etc.)</li>
                <li><strong>Escalation workflows</strong> when AI confidence drops or errors occur</li>
