<% content_for :meta_site do %><% end %>
<% content_for :head do %>
  <% set_meta_tags(
    title: "About A'sTechware | AI & Product Engineering Team",
    description: "A'sTechware is a focused AI and product engineering team with a privacy-first approach to automations, integrations, and delivery. 10+ years, 50+ projects, 98% client retention.",
    keywords: "A'sTechware, production AI, platform engineering, custom software development, AI governance, privacy-first AI"
  ) %>
  <% about_base = Rails.env.production? ? "https://astechware.com" : root_url.chomp("/") %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Person",
    "name" => "Ahmad Kamran",
    "url" => "#{about_base}/about",
    "jobTitle" => "Founder & CEO",
    "worksFor" => { "@type" => "Organization", "name" => "A'sTechware", "url" => about_base },
    "knowsAbout" => ["AI Agent Development", "Platform Engineering", "Custom Software", "Production AI", "AI Governance"],
    "sameAs" => ["https://www.linkedin.com/in/ahmadkamran/"]
  }.to_json) %>
  </script>
<% end %>

<!-- Hero Section -->
<div class="hero-section hero-about py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
          About A&apos;sTechware
        </h1>
        <p class="lead mb-0" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 820px; margin-left: auto; margin-right: auto;">
          We build production-grade AI and platforms for businesses that need systems that actually work. Here&apos;s our story, our team, and what we stand for.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">

  <!-- 1. Company Story -->
  <div class="py-5 bg-white" id="company-story">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Company Story</h2>
          <p class="large-para mb-4">
            A&apos;sTechware was founded to fill a gap we kept seeing: businesses that needed production-ready software and AI systems were getting either fragile demos or overbuilt solutions that never shipped. We started with a simple belief, that great engineering should be accessible to teams that don&apos;t have a full in-house bench, and we&apos;ve stayed focused on that ever since.
          </p>
          <p class="large-para mb-4">
            We chose to specialize in AI and platform engineering because that&apos;s where the biggest leverage is. When we get it right, our clients don&apos;t just get a project delivered; they get systems that scale, comply, and deliver measurable results. We&apos;re here to build those systems with discipline, transparency, and a commitment to outcomes you can actually see.
          </p>
          <p class="large-para mb-4">
            We default to privacy-first AI: integrations and automations are designed so regulated and confidential data is not casually piped to external models, and we align delivery—including AI-assisted development where it applies—with your policies and risk tolerance.
          </p>

          <div class="about-mission-box p-4 mb-4">
            <h3 class="h5 mb-2">Our Mission</h3>
            <p class="mb-0 lead" style="font-size: 1.15rem;">
              Building production-grade AI and platforms for businesses that need systems that actually work.
            </p>
          </div>

          <h3 class="h5 mb-3">Our Values</h3>
          <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="about-value-card p-3 h-100">
                <div class="about-value-icon mb-2"><i class="fa fa-rocket" aria-hidden="true"></i></div>
                <strong class="d-block mb-1">Production-first</strong>
                <p class="mb-0 small">We ship systems that handle real users, real data, and real complexity, not demos that break in production.</p>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="about-value-card p-3 h-100">
                <div class="about-value-icon mb-2"><i class="fa fa-eye" aria-hidden="true"></i></div>
                <strong class="d-block mb-1">Transparency</strong>
                <p class="mb-0 small">Weekly demos, clear milestones, and open communication. You see progress and decisions at every step.</p>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="about-value-card p-3 h-100">
                <div class="about-value-icon mb-2"><i class="fa fa-line-chart" aria-hidden="true"></i></div>
                <strong class="d-block mb-1">Measurable outcomes</strong>
                <p class="mb-0 small">We track hours saved, revenue recovered, and capacity increased. Success is defined by your business results.</p>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="about-value-card p-3 h-100">
                <div class="about-value-icon mb-2"><i class="fa fa-key" aria-hidden="true"></i></div>
                <strong class="d-block mb-1">Client ownership</strong>
                <p class="mb-0 small">You own all code, infrastructure, and documentation from day one. No lock-in, no proprietary hold.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

