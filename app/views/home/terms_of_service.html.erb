<% content_for :head do %>
  <% set_meta_tags title: "Terms of Service | A'sTechware", description: "Terms of Service for A'sTechware. Please read these terms before using our website or services." %>
<% end %>

<div class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">Terms of Service</h1>
        <p class="lead mb-5" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6;">Last updated: <%= Date.current.strftime("%B %Y") %></p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">
  <div class="bg-light-grey">
    <div class="container py-5">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <div class="workflow-card p-4 p-lg-5">
            <p class="large-para mb-4" style="font-size: 18px; line-height: 1.8;">
              By accessing or using A'sTechware's website and services, you agree to be bound by these Terms of Service. If you do not agree, please do not use our site or services.
            </p>
            <h2 class="heading-border mb-3 pb-2 text-start h4">Use of Our Website</h2>
            <p class="mb-4" style="font-size: 18px; line-height: 1.8;">
              Our website and content are provided for informational and business purposes. You may not use them for any unlawful purpose or in any way that could damage or impair the site or our systems.
            </p>
            <h2 class="heading-border mb-3 pb-2 text-start h4">Services &amp; Engagement</h2>
            <p class="mb-4" style="font-size: 18px; line-height: 1.8;">
              Specific projects and engagements are governed by separate agreements. These Terms apply to your use of our public website and general communications only.
            </p>
            <h2 class="heading-border mb-3 pb-2 text-start h4">Contact</h2>
            <p class="mb-0" style="font-size: 18px; line-height: 1.8;">
              For questions about these Terms, please <%= link_to "contact us", contact_path %>. For privacy practices, see our <%= link_to "Privacy Policy", privacy_policy_path %>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
