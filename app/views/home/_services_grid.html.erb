<%# Kept for any legacy renders; prefer what_we_build_list via home/what_we_build %>
<div class="row g-4">
  <% what_we_build_list.each do |service| %>
    <div class="col-12 col-md-6 col-lg-3">
      <%= link_to public_send(service[:path]), class: "text-decoration-none text-dark d-block h-100 ajax" do %>
        <div class="build-system-card p-4 h-100">
          <h3 class="h5 mb-2"><%= service[:title] %></h3>
          <p class="mb-0 small"><%= service[:description] %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
