<% set_meta_tags(
  title: "AI Engineering Partner for Legal, Healthcare & Operations | A'sTechware",
  description: "Production AI engineering partner for legal, healthcare, construction, logistics, and ops-heavy teams. AI agents, workflow automation, dedicated Python/Node.js engineers. Milestone delivery, full code ownership.",
