<% content_for :head do %>
   <%# Using safe helpers to prevent 500 errors if assets fail %>
   <% og_image = safe_og_image_url('logo-colored.png') %>
   <% if og_image.present? %>
     <% set_meta_tags(
       title: "AI Automations & Custom Software for SMBs | A'sTechware",
       description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount.",
       og: {
         title: "AI Automations & Custom Software for SMBs | A'sTechware",
         description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount.",
         image: og_image,
         'image:secure_url' => og_image,
         'image:type' => 'image/png',
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary_large_image',
         title: "AI Automations & Custom Software for SMBs | A'sTechware",
         description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount.",
         image: og_image
       }
     ) %>
   <% else %>
     <% set_meta_tags(
       title: "AI Automations & Custom Software for SMBs | A'sTechware",
       description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount.",
       og: {
         title: "AI Automations & Custom Software for SMBs | A'sTechware",
         description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount.",
         url: safe_request_url,
         type: 'website',
         site_name: "A'sTechware"
       },
       twitter: {
         card: 'summary',
         title: "AI Automations & Custom Software for SMBs | A'sTechware",
         description: "We design and build production-grade AI automations and custom web/mobile platforms from internal ops systems to marketplaces and customer-facing products so businesses can run faster without adding headcount."
       }
     ) %>
   <% end %>
 <% end %>
 
<!-- Hero Section -->
<div class="hero-section py-5">
   <div class="container">
      <div class="row align-items-center min-vh-50">
         <div class="col-12 col-lg-8 mx-auto text-center">
            <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
            AI Automation &amp Custom Software for Growing Teams
            </h1>
            <p class="lead mb-5" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto;">
            We design and build production-ready AI automation and custom web and mobile platforms, from internal operations systems to marketplaces and customer-facing products, so teams can move faster without adding headcount.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center align-items-center">
            <a href="/portfolio" class="btn btn-outline-primary btn-lg rounded-pill px-4 d-flex align-items-center justify-content-center" style="width: 351px; white-space: nowrap; line-height: 40px;">
            View Problems We’ve Solved
            </a>
            <a href="/projects" class="btn btn-primary btn-lg rounded-pill px-4" style="width: 351px;">
               See Project Walkthroughs
            </a>
              
            </div>
         </div>
      </div>
   </div>
</div>
<div class="inner-sections">
   <div class="what-we-do py-5">
      <div class="container">
         <h2 class="heading-border text-center heading-center mb-4 pb-3">What We Build for Growing Businesses</h2>
         <p class="large-para mb-5 text-center">Practical AI automation and custom software systems that replace manual work and help teams scale without adding complexity.
         </p>
         <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-3">
               <div class="card rounded-0 border-0 p-4 h-100">
                  <div class="mb-4" style="font-size: 48px; color: var(--site-color);">
                     <i class="fa fa-bolt" aria-hidden="true"></i>
                  </div>
                  <h4 class="mb-3">Lead &amp; Revenue Automation</h4>
                  <p class="m-0">We build AI systems that respond to leads in real time, qualify prospects, book meetings, and handle follow-ups across email, WhatsApp, phone, and social channels.</p>
               </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
               <div class="card rounded-0 border-0 p-4 h-100">
                  <div class="mb-4" style="font-size: 48px; color: var(--site-color);">
                     <i class="fa fa-bullhorn" aria-hidden="true"></i>
                  </div>
                  <h4 class="mb-3">Marketing &amp; Engagement Automation</h4>
                  <p class="m-0">From social media posting and ads to review monitoring and content repurposing, we automate repetitive marketing tasks that typically consume hours of manual effort.</p>
               </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
               <div class="card rounded-0 border-0 p-4 h-100">
                  <div class="mb-4" style="font-size: 48px; color: var(--site-color);">
                     <i class="fa fa-cogs" aria-hidden="true"></i>
                  </div>
                  <h4 class="mb-3">Operations &amp; Payments Automation</h4>
                  <p class="m-0">We automate proposals, invoices, follow-ups, renewals, internal approvals, and admin workflows so operational friction doesn’t slow revenue.
                  </p>
               </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
               <div class="card rounded-0 border-0 p-4 h-100">
                  <div class="mb-4" style="font-size: 48px; color: var(--site-color);">
                     <i class="fa fa-desktop" aria-hidden="true"></i>
                  </div>
                  <h4 class="mb-3">Custom Web &amp; Mobile Platforms</h4>
                  <p class="m-0">When off-the-shelf tools aren’t enough, we design and build production-grade web and mobile platforms — from internal operations systems to marketplaces and industry-specific software.</p>
               </div>
            </div>
         </div>
         <div class="text-center mt-5">
            <p class="mb-0 text-blue" style="font-size: 20px;">
            Our work includes marketplaces, fintech platforms, operational dashboards, booking systems, directories, and internal tools designed around automation.

            </p>
         </div>
      </div>
   </div>
   <!-- Designed to Reduce Risk Section -->
   <div class="py-5 bg-light-grey">
      <div class="container">
         <div class="row">
            <div class="col-12 col-lg-10 mx-auto">
               <div class="text-center mb-5">
                  <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Designed to Reduce Risk, Not Increase It</h2>
                  <p class="large-para mb-4">Our goal isn't to lock you into a long engagement.<br>It's to earn trust through visible progress and clear control.</p>
               </div>
               <div class="row g-4 mb-5">
                  <div class="col-12 col-md-6">
                     <div class="workflow-card p-4 h-100">
                        <h4 class="mb-3">Milestone-based work with clear outcomes</h4>
                        <p class="mb-0">We break projects into manageable milestones, each delivering tangible value so you can see progress and make informed decisions.</p>
                     </div>
                  </div>
                  <div class="col-12 col-md-6">
                     <div class="workflow-card p-4 h-100">
                        <h4 class="mb-3">Transparent communication and weekly demos</h4>
                        <p class="mb-0">Regular updates and live demonstrations keep you in the loop. You'll always know what's being built and why.</p>
                     </div>
                  </div>
                  <div class="col-12 col-md-6">
                     <div class="workflow-card p-4 h-100">
                        <h4 class="mb-3">Client-owned code and cloud setup</h4>
                        <p class="mb-0">You own everything we build. Code, infrastructure, and documentation are yours from day one, ensuring full control and portability.</p>
                     </div>
                  </div>
                  <div class="col-12 col-md-6">
                     <div class="workflow-card p-4 h-100">
                        <h4 class="mb-3">Clean exit points if priorities change</h4>
                        <p class="mb-0">Projects are structured with natural stopping points. If your needs change, you can pause or adjust without losing value or momentum.</p>
                     </div>
                  </div>
               </div>
               <div class="text-center">
                  <a href="/how-we-derisk-projects" class="btn btn-primary btn-lg rounded-pill px-5">
                     How we de-risk projects →
                  </a>
               </div>
            </div>
         </div>
      </div>
   </div>
