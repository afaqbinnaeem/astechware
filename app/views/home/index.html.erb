<% content_for :head do %>
   <%# Title (page part only; layout adds " | A'sTechware"). Description unique per spec. %>
   <% set_meta_tags(
     title: "AI Agent Development & Custom Software Engineering",
     description: "A'sTechware builds production-grade AI agents, custom software, and platform modernization for B2B SaaS and regulated industries. Milestone-based delivery. Book a free technical call.",
     keywords: "AI development, production AI, platform engineering, custom software, AI governance"
   ) %>
   <%# Homepage-only JSON-LD: WebSite, ProfessionalService, FAQPage, AggregateRating + Reviews %>
   <% home_base = Rails.env.production? ? "https://astechware.com" : root_url.chomp("/") %>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "WebSite",
     "name" => "A'sTechware",
     "url" => home_base,
     "description" => "Production-grade AI and platform engineering. AI agents, custom software, and platform modernization for B2B SaaS and regulated industries.",
     "publisher" => { "@type" => "Organization", "name" => "A'sTechware", "url" => home_base }
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "ProfessionalService",
     "name" => "A'sTechware",
     "url" => home_base,
     "description" => "Production-grade AI agents, custom software, platform modernization, API integrations, and DevOps. Milestone-based delivery, weekly demos, full code ownership.",
     "priceRange" => "$$",
     "areaServed" => "Worldwide",
     "knowsAbout" => ["AI Agent Development", "Machine Learning", "Platform Engineering", "Custom Software", "API Integrations", "DevOps"],
     "hasOfferCatalog" => {
       "@type" => "OfferCatalog",
       "name" => "Services",
       "itemListElement" => [
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "AI Agent Development", "url" => "#{home_base}/services/ai-agent-development" } },
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Machine Learning", "url" => "#{home_base}/services/machine-learning" } },
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Platform Modernization", "url" => "#{home_base}/services/platform-modernization" } },
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Custom Software", "url" => "#{home_base}/services/custom-software" } },
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "API & Integrations", "url" => "#{home_base}/services/api-integrations" } },
         { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "DevOps Engineering", "url" => "#{home_base}/services/devops-engineering" } }
       ]
     }
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "FAQPage",
     "mainEntity" => [
       { "@type" => "Question", "name" => "Do you require large upfront payments?", "acceptedAnswer" => { "@type" => "Answer", "text" => "No. Payments are structured per milestone, not for the entire project upfront." } },
       { "@type" => "Question", "name" => "What if we're not satisfied after a milestone?", "acceptedAnswer" => { "@type" => "Answer", "text" => "You're not obligated to continue. Each milestone stands on its own." } },
       { "@type" => "Question", "name" => "Who owns the code and system?", "acceptedAnswer" => { "@type" => "Answer", "text" => "You do always." } },
       { "@type" => "Question", "name" => "Can another team take over later?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. Everything is documented and portable by design." } },
       { "@type" => "Question", "name" => "Is this approach only for software builds?", "acceptedAnswer" => { "@type" => "Answer", "text" => "No. The same structure applies to automation, AI-assisted systems, and internal tools." } }
     ]
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "Organization",
     "name" => "A'sTechware",
     "url" => home_base,
     "aggregateRating" => { "@type" => "AggregateRating", "ratingValue" => "5.0", "reviewCount" => "11", "bestRating" => "5" },
     "review" => [
       { "@type" => "Review", "author" => { "@type" => "Person", "name" => "Nathan Wolf" }, "reviewBody" => "This is a stellar team! I have assigned new contracts to them for several years. A joy to work with. Smart people. Good people. Honest. Hard working. Excellent results.", "reviewRating" => { "@type" => "Rating", "ratingValue" => "5", "bestRating" => "5" } },
       { "@type" => "Review", "author" => { "@type" => "Person", "name" => "Dale Merritt" }, "reviewBody" => "Been working with Ahmad for almost two years, and they've been great to work with. One of the most reliable developers I've had the pleasure to work with.", "reviewRating" => { "@type" => "Rating", "ratingValue" => "5", "bestRating" => "5" } },
       { "@type" => "Review", "author" => { "@type" => "Person", "name" => "Brianne Harvey" }, "reviewBody" => "Ahmad has been an exceptional contractor and we feel incredibly fortunate to have found him.", "reviewRating" => { "@type" => "Rating", "ratingValue" => "5", "bestRating" => "5" } }
     ]
   }.to_json) %>
   </script>
 <% end %>
 
