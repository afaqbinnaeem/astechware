<section class="py-5 bg-white" id="home-faq">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Common questions</h2>
    </div>
    <div class="home-faq-grid">
      <% [home_faq[0, 4], home_faq[4, 4]].each_with_index do |column, col_idx| %>
        <div class="home-faq-col" data-faq-column>
          <% column.each_with_index do |item, idx| %>
            <% n = col_idx * 4 + idx + 1 %>
            <% answer_id = "homefaq#{n}" %>
            <div class="home-faq-item">
              <h3 class="home-faq-heading">
                <button type="button" class="home-faq-question" id="homeFaqBtn<%= n %>" aria-expanded="false" aria-controls="<%= answer_id %>">
                  <span><%= item[:q] %></span>
                  <span class="home-faq-icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div id="<%= answer_id %>" class="home-faq-answer" role="region" aria-labelledby="homeFaqBtn<%= n %>" aria-hidden="true">
                <p class="mb-0"><%= item[:a] %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="text-center home-faq-more mb-0">
      <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer">Still have a question? Book a 30-min call &rarr;</a>
    </p>
  </div>
</section>

<script>
  (function() {
    var root = document.getElementById("home-faq");
    if (!root || root.dataset.faqBound === "1") return;
    root.dataset.faqBound = "1";
    root.addEventListener("click", function(event) {
      var button = event.target.closest(".home-faq-question");
      if (!button || !root.contains(button)) return;
      var item = button.closest(".home-faq-item");
      var column = button.closest("[data-faq-column]");
      var answer = document.getElementById(button.getAttribute("aria-controls"));
      var willOpen = button.getAttribute("aria-expanded") !== "true";
      if (column) {
        column.querySelectorAll(".home-faq-item.is-open").forEach(function(openItem) {
          if (openItem === item) return;
          var openButton = openItem.querySelector(".home-faq-question");
          var openAnswer = openButton && document.getElementById(openButton.getAttribute("aria-controls"));
          openItem.classList.remove("is-open");
          if (openButton) openButton.setAttribute("aria-expanded", "false");
          if (openAnswer) openAnswer.setAttribute("aria-hidden", "true");
        });
      }
      item.classList.toggle("is-open", willOpen);
      button.setAttribute("aria-expanded", willOpen ? "true" : "false");
      if (answer) answer.setAttribute("aria-hidden", willOpen ? "false" : "true");
    });
  })();
</script>

