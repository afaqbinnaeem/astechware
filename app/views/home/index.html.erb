   <div class="py-5 bg-white" id="astechware_logos">
      <style>
         .logos-marquee {
         overflow: hidden;
         width: 100%;
         position: relative;
         }
         .logos-track {
         display: flex;
         width: max-content;
         animation: scroll-logos 30s linear infinite;
         gap: 48px;
         }
         @keyframes scroll-logos {
         0% { transform: translateX(0); }
         100% { transform: translateX(-50%); }
         }
         .logo-item img {
         max-height: 60px;
         width: auto;
         display: block;
         }
         @media (max-width: 600px) {
         .logos-track { gap: 24px; }
         .logo-item img { max-height: 40px; }
         }
