   <% home_base = Rails.env.production? ? "https://astechware.com" : root_url.chomp("/") %>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "WebSite",
     "name" => "A'sTechware",
     "url" => home_base,
     "description" => "Privacy first AI automations and platform engineering. AI agents, custom software, and modernization for B2B SaaS and regulated industries.",
     "publisher" => { "@type" => "Organization", "name" => "A'sTechware", "url" => home_base }
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "ProfessionalService",
     "name" => "A'sTechware",
     "url" => home_base,
     "description" => "Privacy first AI agents, custom software, platform modernization, API integrations, and DevOps. Milestone based delivery, weekly demos, full code ownership.",
     "priceRange" => "$$",
     "areaServed" => "Worldwide",
    "knowsAbout" => ["AI Agents & Automation", "Custom Platform Development", "Platform Modernization & Scaling", "Integrations & API Engineering", "Construction Software", "Logistics Automation", "Trucking Dispatch", "Real Estate Operations", "Legal Tech Engineering", "Healthcare AI", "Python Development", "Node.js Development", "React Development"],
    "hasOfferCatalog" => {
      "@type" => "OfferCatalog",
      "name" => "Services",
      "itemListElement" => [
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "AI Agents & Automation", "url" => "#{home_base}/services/ai-agent-development" } },
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Custom Platform Development", "url" => "#{home_base}/services/custom-software" } },
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Platform Modernization & Scaling", "url" => "#{home_base}/services/platform-modernization" } },
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Integrations & API Engineering", "url" => "#{home_base}/services/api-integrations" } },
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "Machine Learning Engineering", "url" => "#{home_base}/services/machine-learning" } },
        { "@type" => "Offer", "itemOffered" => { "@type" => "Service", "name" => "DevOps & Cloud Engineering", "url" => "#{home_base}/services/devops-engineering" } }
      ]
    }
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
     "@type" => "FAQPage",
     "mainEntity" => [
       { "@type" => "Question", "name" => "Do you require large upfront payments?", "acceptedAnswer" => { "@type" => "Answer", "text" => "No. Payments are structured per milestone, not for the entire project upfront." } },
       { "@type" => "Question", "name" => "What if we're not satisfied after a milestone?", "acceptedAnswer" => { "@type" => "Answer", "text" => "You're not obligated to continue. Each milestone stands on its own." } },
       { "@type" => "Question", "name" => "Who owns the code and system?", "acceptedAnswer" => { "@type" => "Answer", "text" => "You do always." } },
       { "@type" => "Question", "name" => "Can another team take over later?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. Everything is documented and portable by design." } },
       { "@type" => "Question", "name" => "Is this approach only for software builds?", "acceptedAnswer" => { "@type" => "Answer", "text" => "No. The same structure applies to automation, AI-assisted systems, and internal tools." } },
       { "@type" => "Question", "name" => "Can we hire dedicated backend or frontend engineers through you?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. We provide fractional and dedicated software engineers — backend, frontend, and full-stack — embedded in your workflow with milestone-based delivery and full code ownership." } },
       { "@type" => "Question", "name" => "Do you work as an engineering partner for legal tech and healthcare?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. We build production AI and software for legal operations and healthcare teams with privacy-first architecture, audit trails, and compliance-aware design." } },
       { "@type" => "Question", "name" => "What industries do you build automation systems for?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Legal, healthcare, construction, logistics, trucking, HVAC, real estate, fintech, and B2B SaaS — especially operations-heavy teams with manual workflows and fragmented systems." } },
       { "@type" => "Question", "name" => "Do you build production automation, not just AI demos?", "acceptedAnswer" => { "@type" => "Answer", "text" => "Yes. We ship workflow automation, AI agents, and custom systems with monitoring, human-in-the-loop, error handling, and governance built in from day one." } }
     ]
   }.to_json) %>
   </script>
   <script type="application/ld+json">
   <%= raw({
     "@context" => "https://schema.org",
