<%
  home_faq = [
    {
      q: "What industries do you work with?",
      a: "Mainly legal, healthcare, construction and logistics. We also build for real estate, fintech, HVAC and home services, B2B SaaS and hospitality."
    },
    {
      q: "Do we have to switch software?",
      a: "No. We build around the tools you already use, like QuickBooks, Outlook, your EHR or practice management system, and connect them."
    },
    {
      q: "Do you need a large upfront payment?",
      a: "No. Payments are per milestone, not for the whole project upfront."
    },
    {
      q: "What if we're not happy after a milestone?",
      a: "You're not obligated to continue. Each milestone stands on its own."
    },
    {
      q: "Who owns the code?",
      a: "You do, always. Everything is documented, so another team can take over later if needed."
    },
    {
      q: "Can we hire a dedicated engineer instead of a full project?",
      a: "Yes. We provide dedicated backend, frontend, full-stack and AI engineers who work inside your team, backed by our senior engineers."
    },
    {
      q: "Do you only build AI?",
      a: "No. Most of what we build is regular software: integrations, workflows, portals and apps. We use AI where it actually helps, like reading documents and emails, and a person reviews anything that matters."
    }
  ]
  home_screen_shots = Dir[Rails.root.join("app/assets/images/home/screens/*.webp")].sort
%>
<% set_meta_tags(
  title: "AI Development Company & Automation Agency",
  description: "We build software and automation for legal, healthcare, construction and logistics teams in the US, Canada and Australia. Milestone delivery, full code ownership.",
  keywords: "AI development company, automation agency, custom software, legal tech, healthcare software, construction software, logistics automation, milestone delivery"
) %>
<% content_for :carousel_libraries, "slick" %>
<% content_for :head do %>
  <% home_base = Rails.env.production? ? "https://astechware.com" : root_url.chomp("/") %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "WebSite",
    "name" => "A'sTechware",
    "url" => home_base,
    "description" => "We build software and automation for legal, healthcare, construction and logistics teams in the US, Canada and Australia. Milestone delivery, full code ownership.",
    "publisher" => { "@id" => "https://astechware.com/#organization" }
  }.to_json) %>
  </script>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "ProfessionalService",
    "name" => "A'sTechware",
    "url" => home_base,
    "description" => "We build software and automation for legal, healthcare, construction and logistics teams in the US, Canada and Australia. Milestone delivery, full code ownership.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => ["United States", "Canada", "Australia"],
    "knowsAbout" => ["Custom Software", "Workflow Automation", "AI Agents", "API Integrations", "Legal Tech", "Healthcare AI", "Construction Software", "Logistics Automation"],
    "aggregateRating" => {
      "@type" => "AggregateRating",
      "ratingValue" => "5.0",
      "bestRating" => "5",
      "worstRating" => "1",
      "reviewCount" => "14"
    }
  }.to_json) %>
  </script>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "FAQPage",
    "mainEntity" => home_faq.map { |item|
      {
        "@type" => "Question",
        "name" => item[:q],
        "acceptedAnswer" => { "@type" => "Answer", "text" => item[:a] }
      }
    }
  }.to_json) %>
  </script>
<% end %>

<!-- 1. Hero -->
<div class="hero-section py-5">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <% if home_screen_shots.any? %>
        <div class="col-12 col-lg-6 text-center text-lg-start">
      <% else %>
        <div class="col-12 col-lg-11 mx-auto text-center">
      <% end %>
          <p class="text-uppercase small fw-semibold mb-3" style="letter-spacing: 0.08em; color: rgba(255,255,255,0.85);">
            AI, automation &amp; custom software
          </p>
          <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;" data-page-h1>
            Software that takes the busywork off legal, healthcare, construction and logistics teams
          </h1>
          <p class="lead mb-4" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 950px;<%= home_screen_shots.any? ? "" : " margin-left: auto; margin-right: auto;" %>">
            We build systems that handle intake, scheduling, estimates, dispatch, invoicing and paperwork, connected to the tools you already use, like QuickBooks, Outlook and your EHR. Your team reviews the work instead of doing it by hand.
          </p>
          <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center<%= home_screen_shots.any? ? " justify-content-lg-start" : "" %> align-items-center align-items-sm-stretch">
            <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-4 hero-btn-primary" style="width: 351px;">
              Book a 30-min call
            </a>
            <%= link_to "See our work", case_studies_path, class: "btn btn-outline-primary btn-lg rounded-pill px-4 d-flex align-items-center justify-content-center hero-btn-outline ajax", style: "width: 351px; white-space: nowrap;" %>
          </div>
          <p class="text-white mb-0 mt-4 fs-6" style="max-width: 720px;<%= home_screen_shots.any? ? "" : " margin-left: auto; margin-right: auto;" %>">
            Built for process servers, private clinics, contractors, field service teams, real estate and fintech companies across the US, Canada and Australia.
          </p>
        </div>
      <% if home_screen_shots.any? %>
        <div class="col-12 col-lg-6 mt-4 mt-lg-0">
          <div class="row g-2">
            <% home_screen_shots.first(3).each do |shot| %>
              <div class="col-12 col-sm-6">
                <%= image_tag "home/screens/#{File.basename(shot)}", class: "img-fluid rounded-3 shadow", alt: "Product screenshot", loading: "lazy" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="inner-sections">

<!-- 2. Logo strip -->
<div class="py-5 bg-white" id="astechware_logos">
  <style>
    .logos-marquee {
      overflow: hidden;
      width: 100%;
      position: relative;
    }
    .logos-track {
      display: flex;
      align-items: center;
      width: max-content;
      animation: scroll-logos 30s linear infinite;
      gap: 48px;
    }
    .logos-marquee:hover .logos-track {
      animation-play-state: paused;
    }
    @keyframes scroll-logos {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .logo-item {
      flex-shrink: 0;
    }
    .logo-item img {
      max-height: 60px;
      width: auto;
      max-width: none;
      display: block;
    }
    @media (max-width: 600px) {
      .logos-track { gap: 24px; }
      .logo-item img { max-height: 40px; }
    }
  </style>
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Some of the teams we&apos;ve built for</h2>
    </div>
    <% logos = [
      { src: 'ahmad/logos/word_of_mouth_online_pty_ltd__logo.jpeg', alt: "Word of Mouth Online Pty Ltd, A'sTechware Client" },
      { src: 'ahmad/logos/vestra_software_solutions_logo.jpeg', alt: "Vestra Software Solutions, A'sTechware Client" },
      { src: 'ahmad/logos/zoficash_logo.jpeg', alt: "Zoficash, A'sTechware Client" },
      { src: 'ahmad/logos/golfpay.png', alt: "Golfpay, A'sTechware Client" },
      { src: 'ahmad/logos/rrf.jpeg', alt: "RRF, A'sTechware Client" },
      { src: 'ahmad/logos/thegrantshub_logo.jpeg', alt: "The Grants Hub, A'sTechware Client" },
      { src: 'ahmad/logos/driftgolf_logo.jpeg', alt: "DriftGolf, A'sTechware Client" },
      { src: 'ahmad/logos/1630580396218.jpeg', alt: "Selland Technologies, A'sTechware Client" },
      { src: 'ahmad/logos/zidzid.jpeg', alt: "ZidZid, A'sTechware Client" },
      { src: 'ahmad/logos/warcoconstruction_logo.jpeg', alt: "Warcoconstruction, A'sTechware Client" },
      { src: 'ahmad/logos/instashowing_logo.jpeg', alt: "Instashowing, A'sTechware Client" },
