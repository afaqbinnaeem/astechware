<!-- 2. Logo strip -->
<div class="py-5 bg-white" id="astechware_logos">
  <style>
    .logos-marquee {
      overflow: hidden;
      width: 100%;
      position: relative;
    }
    .logos-track {
      display: flex;
      align-items: center;
      width: max-content;
      animation: scroll-logos 30s linear infinite;
      gap: 48px;
    }
    .logos-marquee:hover .logos-track {
      animation-play-state: paused;
    }
    @keyframes scroll-logos {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .logo-item {
      flex-shrink: 0;
    }
    .logo-item img {
      max-height: 60px;
      width: auto;
      max-width: none;
      display: block;
