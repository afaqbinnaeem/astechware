<%# Shared "Who we work with" row — homepage and /services hub %>
<section class="<%= local_assigns.fetch(:section_class, "py-5 bg-white") %>" id="<%= local_assigns.fetch(:section_id, "who-we-work-with") %>">
  <div class="container">
    <div class="text-center mb-4">
      <h2 class="heading-border heading-center mb-0 pb-3 d-inline-block">Who we work with</h2>
    </div>
    <div class="row g-4">
      <% who_we_work_with_list.each do |item| %>
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="workflow-card p-4 h-100 text-center text-sm-start">
            <div class="mb-2" aria-hidden="true">
              <i class="fa <%= item[:icon] %> fa-2x" style="color: var(--site-color);"></i>
            </div>
            <h3 class="h6 mb-2"><%= item[:title] %></h3>
            <p class="mb-0 small text-muted"><%= item[:description] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
