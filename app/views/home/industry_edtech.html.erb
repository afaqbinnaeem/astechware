<% content_for :head do %>
  <% set_meta_tags(
    title: "Custom EdTech Software Development",
    description: "Custom learning platforms, booking and scheduling, multi-tenant portals and AI tutoring features for training companies and education startups.",
    keywords: "education technology development partner, LMS development, EdTech development, learning management system, AI tutoring, online learning platform, training company software"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "Custom EdTech Software Development",
    "url" => industry_edtech_url,
    "description" => "Custom learning platforms, booking and scheduling, multi-tenant portals and AI tutoring features for training companies and education startups.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => ["United States", "Canada", "Australia"],
    "serviceType" => "EdTech Engineering",
    "category" => "Education Technology"
  }.to_json) %>
  </script>
<% end %>

<div class="hero-section py-5 service-page-hero edtech-hero industry-landing-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-3" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;" data-page-h1>
          Custom EdTech software development
        </h1>
        <p class="text-white fw-semibold mb-3" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.4; max-width: 720px; margin-left: auto; margin-right: auto;">
          Scalable LMS, AI Tutoring, and Automated Grading Engines for Modern Learning
        </p>
        <p class="mb-4" style="font-size: clamp(16px, 2vw, 18px); line-height: 1.6; max-width: 800px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.95);">
          Custom learning platforms, booking and scheduling, multi-tenant portals and AI tutoring features for training companies and education startups in the US, Canada and Australia.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Start with a discovery sprint &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections edtech-industry-page">

  <section class="py-5 bg-white" id="what-we-can-build">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">What we can build for you</h2>
          <p class="large-para mb-4">
            We do not claim a long list of past EdTech clients. We do ship multi-tenant SaaS, document AI, booking systems, and AI features on live products, and we apply that same engineering to learning platforms.
          </p>
          <p class="large-para mb-5">
            Honest offer for two buyers: training and certification companies that need a custom portal, and EdTech founders building a first product.
          </p>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Custom learning platforms and LMS</h3>
            <p class="mb-0 small" style="line-height: 1.7;">
              Course catalogs, progress tracking, assessments, certificates, and admin tools shaped to your program, not a generic LMS you fight every week.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Booking and scheduling for training</h3>
            <p class="mb-0 small" style="line-height: 1.7;">
              Class schedules, instructor assignment, capacity rules, and reminders for cohort based or one to one training businesses.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Multi-tenant portals</h3>
            <p class="mb-0 small" style="line-height: 1.7;">
              Separate orgs, white label experiences, and tenant isolated data for companies that sell training to other businesses.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">AI tutoring and content assist</h3>
            <p class="mb-0 small" style="line-height: 1.7;">
              Draft feedback, practice Q&amp;A, and content helpers with human review where grades or credentials are on the line. Numbers and pass/fail rules stay deterministic.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="related-work">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Related work</h2>
        <p class="text-muted mb-0">Transferable builds we have already shipped, not EdTech client claims.</p>
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Multi-tenant SaaS: process serving platform</h3>
            <p class="mb-0" style="line-height: 1.7;">
              Production multi-tenant SaaS with database level isolation, document intake, and audit grade workflows. The same isolation and portal patterns apply to training companies selling to multiple client orgs.
            </p>
            <%= link_to "Read the full case study &rarr;".html_safe, case_study_path("flss-legal-process-serving"), class: "d-inline-block mt-4 fw-semibold ajax" %>
          </div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Document AI: construction estimator</h3>
            <p class="mb-0" style="line-height: 1.7;">
              AI estimating from site walk notes and plan PDFs into structured line items. Same document to structured data approach as curriculum parsing, assignment intake, or certification paperwork.
            </p>
            <%= link_to "Read the full case study &rarr;".html_safe, case_study_path("construction-management-platform"), class: "d-inline-block mt-4 fw-semibold ajax" %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="who-we-work-with">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Who we work with</h2>
          <ul class="mb-0 ps-3 large-para" style="line-height: 2;">
            <li>Training and certification companies that need a custom portal, booking, or multi-tenant delivery</li>
            <li>EdTech founders building a first learning product</li>
          </ul>
          <p class="large-para mt-4 mb-0 text-muted">
            We are not pitching K-12 districts, universities, or Fortune 500 L&amp;D as past clients. If that is your buyer, we will say so on the first call and decide together whether the fit is real.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="engage">
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">How we engage</h2>
          <p class="large-para mb-4">
            Paid one week discovery sprint. You own the written deliverable either way:
          </p>
          <div class="workflow-card p-4 p-lg-5 mb-4">
            <ul class="mb-0 ps-3" style="line-height: 2;">
              <li>A product map of learners, admins, content, and credentialing touchpoints</li>
              <li>An architecture recommendation for multi-tenant vs single org, booking, and AI scope</li>
              <li>A phased build plan with milestones</li>
            </ul>
          </div>
          <div class="text-center">
            <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
              Start a discovery sprint &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="faq">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">FAQ</h2>
      </div>
      <div class="row">
        <div class="col-12 col-lg-10 mx-auto">
          <div class="accordion edtech-industry-faq" id="edtechIndustryFaq">
            <div class="accordion-item border rounded mb-2">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edufaq1" aria-expanded="false" aria-controls="edufaq1">Have you built an LMS before?</button>
              </h3>
              <div id="edufaq1" class="accordion-collapse collapse" data-bs-parent="#edtechIndustryFaq">
                <div class="accordion-body">We have not published a dedicated EdTech case study. What we have shipped is multi-tenant SaaS, document AI, booking platforms, and AI features on live products. We will be explicit about what is proven vs transferable on the first call.</div>
              </div>
            </div>
            <div class="accordion-item border rounded mb-2">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edufaq2" aria-expanded="false" aria-controls="edufaq2">Can AI grade assignments automatically?</button>
              </h3>
              <div id="edufaq2" class="accordion-collapse collapse" data-bs-parent="#edtechIndustryFaq">
                <div class="accordion-body">AI can draft feedback and score rubrics where a human still approves. Pass/fail rules, certificate issuance, and any credential that must hold up under audit should stay deterministic code with a clear audit trail.</div>
              </div>
            </div>
            <div class="accordion-item border rounded mb-2">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edufaq3" aria-expanded="false" aria-controls="edufaq3">Who owns the code?</button>
              </h3>
              <div id="edufaq3" class="accordion-collapse collapse" data-bs-parent="#edtechIndustryFaq">
                <div class="accordion-body">You do. Milestone delivery, repositories in your accounts. No lock in.</div>
              </div>
            </div>
            <div class="accordion-item border rounded mb-2">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#edufaq4" aria-expanded="false" aria-controls="edufaq4">Do you integrate with existing LMS tools?</button>
              </h3>
              <div id="edufaq4" class="accordion-collapse collapse" data-bs-parent="#edtechIndustryFaq">
                <div class="accordion-body">We can integrate with tools you already use when the APIs support it. We describe that as integration capability, not as a past EdTech project list.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>
