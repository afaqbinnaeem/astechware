<% content_for :head do %>
  <% set_meta_tags(
    title: "Software Development for UAE & Saudi Arabia",
    description: "Custom software and automation for construction, healthcare and logistics companies in the UAE, Saudi Arabia, Qatar and Oman, from an engineering team in Pakistan.",
    keywords: "GCC software engineering partner, GCC software development, UAE AI automation, Saudi Arabia technology partner, construction management software Gulf, healthcare software UAE"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "AI and Software Development for Gulf Companies",
    "url" => gcc_url,
    "description" => "Custom software and automation for construction, healthcare and logistics companies in the UAE, Saudi Arabia, Qatar and Oman, from an engineering team in Pakistan.",
    "provider" => { "@id" => "https://astechware.com/#organization" },
    "areaServed" => [
      { "@type" => "Country", "name" => "United Arab Emirates" },
      { "@type" => "Country", "name" => "Saudi Arabia" },
      { "@type" => "Country", "name" => "Qatar" },
      { "@type" => "Country", "name" => "Oman" }
    ],
    "serviceType" => "AI Automation & Custom Software Development"
  }.to_json) %>
  </script>
<% end %>

<!-- Arabic trust line -->
<div class="gcc-trust-bar py-3">
  <div class="container">
    <%# Arabic trust line: leave blank until a native speaker supplies approved copy %>
    <p class="gcc-arabic-translation mb-0 text-center small text-muted">
      We work with companies in the US, Canada, Australia and the UK, and we&rsquo;re expanding into the UAE, Saudi Arabia, Qatar and Oman.
    </p>
  </div>
</div>

<!-- Hero -->
<div class="hero-section py-5 service-page-hero gcc-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;" data-page-h1>
          AI and software development for Gulf companies
        </h1>
        <p class="text-white fw-semibold mb-3" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.4; max-width: 720px; margin-left: auto; margin-right: auto;">
          AI Systems Built for Gulf Enterprises
        </p>
        <p class="mb-4" style="font-size: clamp(16px, 2vw, 18px); line-height: 1.6; max-width: 900px; margin-left: auto; margin-right: auto; color: rgba(255,255,255,0.95);">
          We work with companies in the US, Canada, Australia and the UK, and we&rsquo;re expanding into the UAE, Saudi Arabia, Qatar and Oman. Custom software and automation for construction, healthcare and logistics, from an engineering team in Pakistan.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Start with a discovery sprint &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Trust bar: same stats as homepage -->
<div class="py-4" id="gcc-metrics">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-6 col-md-3">
        <div class="metric-number">2022</div>
        <div class="metric-label">Founded</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">50+</div>
        <div class="metric-label">Projects Delivered</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">100%</div>
        <div class="metric-label">Client Retention</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">20–25</div>
        <div class="metric-label">Engineers on the Team</div>
      </div>
    </div>
    <p class="text-center small text-muted mt-3 mb-0">
      Hours are flexible based on the client. Engineering team in Lahore, Pakistan.
    </p>
  </div>
</div>

<div class="inner-sections gcc-page">

  <section class="py-5 bg-white" id="vision">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Built for the region&rsquo;s transformation</h2>
        <p class="large-para mb-0">
          Vision 2030 and the UAE National AI Strategy are pushing construction, healthcare, and logistics toward digital transformation. Most companies know they need to automate. Few know how to do it without ending up with a system that breaks six months after launch. That is the gap we fill, using the same production systems we have already shipped in the US, Canada, Australia and the UK.
        </p>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="verticals">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Industries we can serve in the Gulf</h2>
        <p class="text-muted mb-0">Links go to industry pages we already ship. We do not invent Gulf client logos.</p>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Construction &amp; field operations</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Estimating, subcontracting, invoicing, and job site workflows. See the construction management platform we built for a US multi-company group.
            </p>
            <p class="mt-3 mb-0">
              <%= link_to "Operations-heavy software →", industry_professional_services_path, class: "service-card-link ajax" %>
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Healthcare</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              HIPAA-ready patient booking, AI scribing, and EHR integrations for clinic groups and healthtech teams.
            </p>
            <p class="mt-3 mb-0">
              <%= link_to "Healthcare AI →", industry_healthcare_path, class: "service-card-link ajax" %>
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Legal service companies</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Intake, dispatch, evidence chains, and document workflows for process servers and other legal service companies.
            </p>
            <p class="mt-3 mb-0">
              <%= link_to "Legal services software →", industry_legal_path, class: "service-card-link ajax" %>
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Fintech &amp; B2B SaaS</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Payment platforms, multi-tenant SaaS rescue, and modernization for products that already have customers.
            </p>
            <p class="mt-3 mb-0">
              <%= link_to "Fintech →", industry_financial_path, class: "service-card-link ajax" %>
              <span class="text-muted mx-2">·</span>
              <%= link_to "B2B SaaS →", industry_b2b_saas_path, class: "service-card-link ajax" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="buildcm">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Featured build: construction management platform</h2>
        <p class="large-para mb-4">
          A full construction management platform built for a US based multi-company construction group. Covers AI estimating from site walk notes and plan PDFs, subcontract management, invoicing, QuickBooks Online sync, and payment processing.
        </p>
        <p class="large-para mb-4">
          This is the kind of platform Gulf construction companies need. We built it once. We can build the same class of system for you.
        </p>
        <%= link_to "Read the case study →", case_study_path("construction-management-platform"), class: "btn btn-primary btn-lg rounded-pill px-5 ajax" %>
      </div>
    </div>
  </section>

  <section class="py-5 bg-light-grey" id="why-us">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Why work with us from the Gulf</h2>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Pakistan based engineering team</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Our engineering team is based in Lahore, Pakistan. Hours are flexible based on the client so we can align overlap with GCC business days when you need it.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">No demo grade delivery</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              We build systems designed to run in production, not impress in a pitch. Governance, error handling, and security built in from day one.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Milestone based contracts</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              You own the code. Payment tied to delivery milestones. No lock in.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Regulated industry experience</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Healthcare, legal service companies, and fintech. We have built in environments where compliance is not optional. That discipline carries into every build.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-white" id="gcc-cta">
    <div class="container">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Ready to talk?</h2>
        <p class="large-para mb-4">
          Tell us what you&rsquo;re building or what&rsquo;s breaking. We&rsquo;ll be direct about whether we can help.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Start a discovery sprint &rarr;
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  .gcc-trust-bar {
    background: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
  }

  .gcc-arabic-line {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.7;
    color: #1a1a2e;
  }

  .gcc-arabic-translation {
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }

  #gcc-metrics .metric-number {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
  }

  #gcc-metrics .metric-label {
    font-size: 0.9rem;
    color: #6c757d;
  }
</style>
