<% content_for :head do %>
  <% set_meta_tags(
    title: "AI Systems Built for Gulf Enterprises | UAE, Saudi Arabia, Qatar & Oman",
    description: "Production-grade AI automation and custom software for GCC companies. Construction, healthcare, legal, and field operations. Milestone-based delivery, timezone aligned with Gulf business hours.",
    keywords: "GCC software development, UAE AI automation, Saudi Arabia Vision 2030 technology, construction management software Gulf, healthcare software UAE, legal tech Middle East"
  ) %>
  <script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "Service",
    "name" => "AI Systems for Gulf Enterprises",
    "url" => gcc_url,
    "description" => "Production-grade AI automation and custom software for companies across UAE, Saudi Arabia, Qatar, and Oman.",
    "provider" => { "@type" => "Organization", "name" => "A'sTechware" },
    "areaServed" => [
      { "@type" => "Country", "name" => "United Arab Emirates" },
      { "@type" => "Country", "name" => "Saudi Arabia" },
      { "@type" => "Country", "name" => "Qatar" },
      { "@type" => "Country", "name" => "Oman" }
    ],
    "serviceType" => "AI Automation & Custom Software Development"
  }.to_json) %>
  </script>
<% end %>

<!-- Arabic trust line -->
<div class="gcc-trust-bar py-3">
  <div class="container">
    <p class="gcc-arabic-line mb-0 text-center" lang="ar" dir="rtl">
      نفخر بخدمة الشركات في الإمارات والمملكة العربية السعودية وقطر وعُمان
    </p>
    <p class="gcc-arabic-translation mb-0 text-center small text-muted mt-1">
      We are proud to serve companies in UAE, Saudi Arabia, Qatar and Oman
    </p>
  </div>
</div>

<!-- Hero -->
<div class="hero-section py-5 service-page-hero gcc-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-9 mx-auto text-center">
        <h1 class="display-4 fw-bold mb-4" style="font-size: clamp(32px, 5vw, 56px); line-height: 1.2;">
          AI Systems Built for Gulf Enterprises
        </h1>
        <p class="lead mb-4" style="font-size: clamp(18px, 2.5vw, 22px); line-height: 1.6; max-width: 900px; margin-left: auto; margin-right: auto;">
          We build production-grade AI automation and custom software for companies across UAE, Saudi Arabia, Qatar, and Oman — the same way we&rsquo;ve done it for clients in the US, Canada, and Australia for over 10 years.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Book a Free Strategy Call
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Trust bar -->
<div class="py-4" id="gcc-metrics">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-6 col-md-3">
        <div class="metric-number">10+</div>
        <div class="metric-label">Years in Operation</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">50+</div>
        <div class="metric-label">Projects Shipped</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">98%</div>
        <div class="metric-label">Client Retention</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="metric-number">5h+</div>
        <div class="metric-label">GCC Business Hours Aligned</div>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections gcc-page">

  <!-- Vision 2030 -->
  <section class="py-5 bg-white" id="vision">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Built for the Region&rsquo;s Transformation</h2>
        <p class="large-para mb-0">
          Vision 2030 and the UAE National AI Strategy are pushing every sector — construction, healthcare, legal, logistics — toward digital transformation. Most companies know they need to automate. Few know how to do it without ending up with a system that breaks six months after launch. That&rsquo;s the gap we fill.
        </p>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="py-5 bg-light-grey" id="verticals">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Industries We Serve in the Gulf</h2>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Construction &amp; Real Estate</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              From multi-site project management to AI-powered estimating and subcontract automation. We built BuildCM — a full construction management platform — from scratch in 35 days. Vision 2030 infrastructure projects are exactly the environment this was designed for.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Healthcare</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              HIPAA-compliant patient booking, AI scribing, multi-clinic management, and EHR integrations. Built for clinic groups and hospital networks managing high patient volumes with lean admin teams.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Legal Tech</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              AI-powered intake, document generation, contract workflows, and case management for law firms and legal operations teams. Reduces manual work without replacing your legal team&rsquo;s judgment.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Field Service &amp; Logistics</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Dispatch automation, real-time fleet visibility, job scheduling, and operational dashboards for companies running field teams across multiple locations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured case study -->
  <section class="py-5 bg-white" id="buildcm">
    <div class="container">
      <div class="col-12 col-lg-10 mx-auto">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Featured Build: BuildCM</h2>
        <p class="large-para mb-4">
          A full construction management platform built for a US-based multi-company construction group. Covers AI estimating from site walk notes and plan PDFs, subcontract management, invoicing, QuickBooks Online sync, and payment processing — all in one system.
        </p>
        <p class="large-para mb-4">
          This is the kind of platform Gulf construction companies running Vision 2030 projects need. We built it once. We can build it for you.
        </p>
        <div class="text-center mb-4">
          <%= image_tag 'ahmad/logos/warcoconstruction_logo.jpeg', class: 'img-fluid gcc-client-logo', alt: "Warco Construction, A'sTechware client", loading: 'lazy' %>
        </div>
        <%= link_to "See How It Works", case_study_path("construction-management-platform"), class: "btn btn-primary btn-lg rounded-pill px-5 ajax" %>
      </div>
    </div>
  </section>

  <!-- Why A'sTechware -->
  <section class="py-5 bg-light-grey" id="why-us">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Why Gulf Companies Work With Us</h2>
      </div>
      <div class="row g-4">
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Timezone aligned</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Our working hours run afternoons through midnight PKT — directly overlapping with GCC business hours. No 9-hour lag. No waiting until your tomorrow.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">No demo-grade delivery</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              We build systems designed to run in production, not impress in a pitch. Governance, error handling, and security built in from day one.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">Milestone-based contracts</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              You own the code. Payment tied to delivery milestones, not retainers. No lock-in.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="workflow-card p-4 p-lg-5 h-100">
            <h3 class="h5 mb-3">10 years of regulated industry experience</h3>
            <p class="mb-0 small" style="line-height: 1.75;">
              Healthcare, legal, fintech — we&rsquo;ve built in environments where compliance isn&rsquo;t optional. That discipline carries into every build.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-5 bg-white" id="gcc-cta">
    <div class="container">
      <div class="col-12 col-lg-8 mx-auto text-center">
        <h2 class="heading-border heading-center mb-4 pb-3 d-inline-block">Ready to Talk?</h2>
        <p class="large-para mb-4">
          Tell us what you&rsquo;re building or what&rsquo;s breaking. We&rsquo;ll be direct about whether we can help.
        </p>
        <a href="https://calendly.com/ahmadkamran/new-meeting" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-pill px-5">
          Book a Free Strategy Call
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  .gcc-trust-bar {
    background: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
  }

  .gcc-arabic-line {
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.7;
    color: #1a1a2e;
  }

  .gcc-arabic-translation {
    font-size: 0.85rem;
    letter-spacing: 0.01em;
  }

  #gcc-metrics {
    background: var(--text-color);
  }

  .gcc-client-logo {
    max-height: 72px;
    width: auto;
    opacity: 0.9;
  }
</style>
