<% content_for :head do %>
  <% set_meta_tags(
    title: "Integrations We Build",
    description: IntegrationCatalog::INDEX_META_DESCRIPTION,
    keywords: "QuickBooks integration, Stripe Connect integration, Twilio integration, FHIR integration, RESO MLS API, DocuSign integration, API integrations"
  ) %>
<% end %>

<div class="hero-section py-5 service-page-hero">
  <div class="container">
    <div class="row align-items-center min-vh-50">
      <div class="col-12 col-lg-8 text-start">
        <h1 class="display-4 fw-bold mb-3" data-page-h1>
          Integrations we build
        </h1>
        <p class="mb-0 hero-lead" style="max-width: 36rem">
          Production connections we have engineered for legal, healthcare, construction, logistics, real estate, and fintech teams—grounded in shipped case studies, from work we have shipped.
        </p>
      </div>
    </div>
  </div>
</div>

<div class="inner-sections">
  <section class="py-5 bg-light-grey track-lines-section"  id="integration-cards">
  <%= render "shared/track_lines_background", tone: "gradient" %>
    <div class="container track-lines-content">
      <div class="row g-4 track-lines-grid">
        <% @integrations.each do |slug, entry| %>
          <div class="col-12 col-md-6 col-lg-4">
            <%= link_to integration_path(slug), class: "text-decoration-none text-dark d-block h-100 ajax" do %>
              <div class="workflow-card p-4 h-100">
                <h2 class="h5 mb-2"><%= entry[:title] %></h2>
                <p class="mb-3 small text-muted" style="line-height: 1.6;">
                  <%= Array(entry[:intro]).first %>
                </p>
                <% if entry[:case_study_slugs].present? %>
                  <p class="mb-0 small fw-semibold text-primary">View integration &rarr;</p>
                <% else %>
                  <p class="mb-0 small fw-semibold text-primary">Learn more &rarr;</p>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "shared/related_links", page_key: "integrations" %>

  <section class="py-5 bg-white">
    <div class="container text-center">
      <p class="large-para mb-4" style="max-width: 900px; margin-left: auto; margin-right: auto;">
        Need a hub-and-spoke integration architecture, error handling, and monitoring—not a one-off script? Our API integration practice covers discovery through production handoff.
      </p>
      <%= link_to "API integration services →", api_integrations_path, class: "service-card-link ajax" %>
    </div>
  </section>
</div>