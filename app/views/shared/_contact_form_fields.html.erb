<%# Shared contact form fields. Locals: f (form builder), recaptcha_field_id (String) %>
<% recaptcha_field_id = local_assigns.fetch(:recaptcha_field_id, "g-recaptcha-response-contact") %>
<div class="row">
  <div class="col-12 col-md-6 mb-4">
    <%= f.text_field :name, class: "form-control", placeholder: "Name*", required: true %>
  </div>
  <div class="col-12 col-md-6 mb-4">
    <%= f.email_field :email, class: "form-control", placeholder: "Email*", required: true %>
  </div>
</div>
<div class="row">
  <div class="col-12 col-md-6 mb-4">
    <%= f.text_field :phone, class: "form-control", placeholder: "Phone" %>
  </div>
  <div class="col-12 col-md-6 mb-4">
    <%= f.text_field :company_name, class: "form-control", placeholder: "Company Name" %>
  </div>
</div>
<div class="col-12 mb-4">
  <%= f.select :need_type,
    [
      ["Web or mobile app", "Web or mobile app"],
      ["AI or automation", "AI or automation"],
      ["MVP for a new product", "MVP for a new product"],
      ["Integrations", "Integrations"],
      ["Modernizing an existing system", "Modernizing an existing system"],
      ["A dedicated engineer", "A dedicated engineer"],
      ["New product", "New product"],
      ["Improving an existing system", "Improving an existing system"],
      ["Adding engineers to my team", "Adding engineers to my team"],
      ["Something else", "Something else"]
    ],
    { include_blank: "What do you need?*" },
    { class: "form-control form-select", required: true, "aria-label": "What do you need?" } %>
</div>
<%# [[AHMAD: budget field yes/no]] — do not add budget select until confirmed %>
<div class="col-12 mb-4">
  <%= f.text_area :cover_letter, class: "form-control", placeholder: "Message*", required: true, rows: 5 %>
</div>
<% if recaptcha_site_key.present? %>
  <%= hidden_field_tag 'g-recaptcha-response', '', id: recaptcha_field_id %>
<% end %>
<div class="row">
  <div class="col-9">
    <% if flash[:notice] %>
      <div class="alert alert-warning" role="alert" id="form-contact-alert">
        We&apos;ve received your query successfully, we will get back to you shortly.
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="alert alert-danger" role="alert" id="form-contact-alert">
        <%= flash[:alert] %>
      </div>
    <% end %>
  </div>
  <div class="col-3">
    <div class="d-flex justify-content-end">
      <%= f.submit "Send", class: local_assigns.fetch(:submit_class, "btn btn-primary rounded-pill") %>
    </div>
  </div>
</div>
