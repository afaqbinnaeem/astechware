<div data-controller="chat" class="chat-widget-container" id="chat-widget-container">
  <!-- Minimized Bubble -->
  <div data-chat-target="bubble" class="chat-bubble" data-action="click->chat#toggle">
    <i class="fa fa-comments"></i>
  </div>

  <!-- Chat Window -->
  <div data-chat-target="window" class="chat-window" style="display: none;">
    <!-- Header -->
    <div class="chat-header">
      <div class="chat-header-content">
        <h5 class="chat-header-title mb-0">How can I help you today?</h5>
        <p class="chat-header-subtitle mb-0">Ask me anything about A'sTechware</p>
      </div>
      <button type="button" class="chat-minimize-btn" data-action="click->chat#toggle" aria-label="Minimize chat">
        <i class="fa fa-minus"></i>
      </button>
    </div>

    <!-- Messages Container -->
    <div data-chat-target="messages" class="chat-messages">
      <!-- Welcome message -->
      <div class="chat-message chat-message-ai">
        <div class="chat-message-content">
          Hello! I'm here to help you learn about A'sTechware. What would you like to know?
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="chat-input-area">
      <form data-action="submit->chat#sendMessage">
        <div class="input-group">
          <input
            type="text"
            data-chat-target="input"
            class="form-control chat-input"
            placeholder="Type your message..."
            autocomplete="off"
            data-action="keydown->chat#handleKeyPress"
          />
          <button
            type="submit"
            data-chat-target="sendButton"
            class="btn btn-primary chat-send-btn"
            aria-label="Send message"
          >
            <i class="fa fa-paper-plane"></i>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
