<% page_key = local_assigns[:page_key].presence || RelatedLinks.normalize_key(request.path) %>
<% return if defined?(@related_links_rendered) && @related_links_rendered %>
<% links = resolved_related_links(local_assigns[:links].presence || RelatedLinks.for_path(page_key)) %>
<% return if links.blank? %>
<% @related_links_rendered = true %>
<section class="py-5 bg-light-grey" id="related-work-resources" aria-labelledby="related-work-resources-heading">
  <div class="container">
    <div class="col-12 col-lg-10 mx-auto text-center">
      <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block" id="related-work-resources-heading">Related work &amp; resources</h2>
      <p class="text-muted mb-4">Explore adjacent services, industries, integrations, and case studies on the same topic.</p>
      <nav class="related-links-nav" aria-label="Related work and resources">
        <ul class="list-unstyled d-flex flex-wrap justify-content-center gap-2 gap-md-3 mb-0">
          <% links.each do |link| %>
            <li>
              <%= link_to link[:label], link[:href], class: "btn btn-outline-primary btn-sm rounded-pill px-3 ajax" %>
            </li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</section>