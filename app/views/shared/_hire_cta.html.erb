<%= render "shared/related_links" %>

<% if route_helper_defined?(:hire_ai_engineers_path) || route_helper_defined?(:hire_dedicated_developers_path) %>
<section class="py-5 bg-light-grey" id="hire-one-engineer">
  <div class="container">
    <div class="col-12 col-lg-10 mx-auto text-center">
      <h2 class="heading-border heading-center mb-3 pb-3 d-inline-block">Need just one engineer?</h2>
      <p class="large-para mb-4">
        Hire a dedicated developer who works in your tools&mdash;backed by our team of 20–25 for review and cover.
      </p>
      <p class="mb-0">
        <% if route_helper_defined?(:hire_ai_engineers_path) %>
          <%= link_to "Hire AI engineers", hire_ai_engineers_path, class: "btn btn-outline-primary rounded-pill px-4 me-2 mb-2 ajax" %>
        <% end %>
        <% if route_helper_defined?(:hire_dedicated_developers_path) %>
          <%= link_to "Hire dedicated developers", hire_dedicated_developers_path, class: "btn btn-primary rounded-pill px-4 mb-2 ajax" %>
        <% end %>
      </p>
    </div>
  </div>
</section>
<% end %>